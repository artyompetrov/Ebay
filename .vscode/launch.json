{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Test API: Debug Tests Project",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/Ebay/Tests/Tests.csproj"
    },
    {
      "name": "Run Server (dotnet run)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-server",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/Ebay/Server/Server.csproj"
      ],
      "cwd": "${workspaceFolder}/src/Ebay/Server",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Run Tests (dotnet test)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/src/Ebay/Tests/Tests.csproj"
      ],
      "cwd": "${workspaceFolder}/src/Ebay",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
