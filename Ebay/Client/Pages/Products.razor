@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Ebay.Client.Extensions

@attribute [Authorize]
@inject EbayClient EbayClient

<style>
.hoverPanel {
  text-align: left;
  padding: 15px;
  border: 3px solid;
  border-radius: 10px;
  position:fixed;
  z-index:100;
  bottom:5%;
  background-color: white;
}
.hoverPanel  label
{
  font-weight: bold;
  display: block;
  width: 200px;
  float: left;
}
.hoverPanel label:after { content: ": " }
</style>

<PageTitle>Перечень товаров</PageTitle>

<h1>Перечень товаров</h1>
<button class="btn btn-primary" @onclick="OnAddNewProductButtonClick">Добавить</button>


<table class="table">
    <thead>
    <tr>
        <th>Название</th>
        <th>Поисковый запрос</th>
        <th>Редактировать</th>
        <th>Удалить</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var product in _products)
    {
        <tr>
            <td>@product.Name</td>
            <td>@product.SearchQuery</td>
            <td>
                <button class="btn btn-primary" @onclick="@(e => SelectProductToEdit(product))">Редактировать</button>
            </td>
            <td>
                <button class="btn btn-primary" @onclick="@(e => DeleteProduct(product))">Удалить</button>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (_createFormModel != null)
{
    <EditProduct Product="@_createFormModel" ActionName="Создать" OnSubmit="@CreateFormSubmit" OnCancel="@HideCreateAndEditForms"/>
}
else if (_editFormModel != null)
{
    <EditProduct Product="@_editFormModel" ActionName="@($"Редактировать {_editFormModel.Name}")" OnSubmit="@OnEditFormSubmit" OnCancel="@HideCreateAndEditForms"/>
}

@code {
    private ICollection<ProductWithId> _products = new List<ProductWithId>();
    ProductWithId? _editFormModel;
    ProductWithId? _createFormModel;

    protected override async Task OnInitializedAsync()
    {
        await LoadActualProductList();
    }
    
    private void OnAddNewProductButtonClick()
    {
        _createFormModel = new ProductWithId { Name = "", SearchQuery = "" };
        _editFormModel = null;
    }

    private async Task DeleteProduct(ProductWithId product)
    {
        HideCreateAndEditForms();
        await EbayClient.DeleteProductAsync(product.Id);
        await LoadActualProductList();
    }

    private void SelectProductToEdit(ProductWithId product)
    {
        _editFormModel = product.Copy();
        _createFormModel = null;
    }
    
    private async Task LoadActualProductList()
    {
        try
        {
            _products = await EbayClient.GetAllProductsAsync();
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect(); //todo по хорошему надо вообще все вызовы оборачивать
        }
    }

    private async Task OnEditFormSubmit()
    {
        if (_editFormModel == null) throw new InvalidOperationException($"{nameof(_editFormModel)} expected to be not null");
        await EbayClient.UpdateProductAsync(product: _editFormModel.ToProductWithoutId(), id: _editFormModel.Id);
        HideCreateAndEditForms();
        await LoadActualProductList();
    }

    private async Task CreateFormSubmit()
    {
        if (_createFormModel == null) throw new InvalidOperationException($"{nameof(_createFormModel)} expected to be not null");
        await EbayClient.CreateProductAsync(_createFormModel.ToProductWithoutId());
        HideCreateAndEditForms();
        await LoadActualProductList();
    }

    private void HideCreateAndEditForms()
    {
        _createFormModel = null;
        _editFormModel = null;
    }

}