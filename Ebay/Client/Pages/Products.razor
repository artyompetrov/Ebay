@page "/"
@using Ebay.Client.Clients.Generated
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject EbayClient EbayClient

<PageTitle>Перечень товаров</PageTitle>

<h1>Перечень товаров</h1>
<button class="btn btn-primary" @onclick="@(() => _productPopupComponent.ShowCreate())">Добавить</button>


<table class="table">
    <thead>
    <tr>
        <th>Название</th>
        <th>Поисковый запрос</th>
        <th>Редактировать</th>
        <th>Удалить</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var product in _products)
    {
        <tr>
            <td>@product.Name</td>
            <td>@foreach (var query in product.SearchQueries)
                {
                    <a href="@GetSearchLink(query.Query)" target=”_blank”>@query.Query</a>
                }
            </td>
            <td>
                <button class="btn btn-primary btn-sm" @onclick="@(e => _productPopupComponent.ShowEdit(product))">Редактировать</button>
            </td>
            <td>
                <button class="btn btn-primary btn-sm" @onclick="@(e => OnDeleteButtonClick(product))">Удалить</button>
            </td>
        </tr>
    }
    </tbody>
</table>

<ProductPopup @ref="_productPopupComponent" OnSuccess="LoadActualProductList"/>
<QuestionPopup @ref="_questionPopup"/>

@code {
    private ProductPopup _productPopupComponent = null!;
    private QuestionPopup _questionPopup = null!;

    private ICollection<ProductWithId> _products = new List<ProductWithId>();

    protected override async Task OnInitializedAsync()
    {
        await LoadActualProductList();
    }

    private void OnDeleteButtonClick(ProductWithId product)
    {
        _questionPopup.AskQuestion($"Вы действительно хотите удалить товар '{product.Name}'?", async () =>
        {
            await EbayClient.DeleteProductAsync(product.Id);
            await LoadActualProductList();
        });
    }

    private async Task LoadActualProductList()
    {
        _products = await EbayClient.GetAllProductsAsync();
        StateHasChanged();
    }

    private string GetSearchLink(string query) => $"https://www.ebay.com/sch/i.html?_nkw={query}&LH_Sold=1";


}