@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Ebay.Client.Extensions
@using Ebay.Client.Clients.Generated
@attribute [Authorize]
@inject EbayClient EbayClient

<PageTitle>Перечень товаров</PageTitle>

<h1>Перечень товаров</h1>
<button class="btn btn-primary" @onclick="OnAddNewProductButtonClick">Добавить</button>


<table class="table">
    <thead>
    <tr>
        <th>Название</th>
        <th>Поисковый запрос</th>
        <th>Редактировать</th>
        <th>Удалить</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var product in _products)
    {
        <tr>
            <td>@product.Name</td>
            <td>@product.SearchQuery</td>
            <td>
                <button class="btn btn-primary" @onclick="@(e => OnEditButtonClick(product))">Редактировать</button>
            </td>
            <td>
                <button class="btn btn-primary" @onclick="@(e => OnDeleteButtonClick(product))">Удалить</button>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (_productToCreate != null)
{
    <EditProduct Product="@_productToCreate" ActionName="Создать" OnSubmit="@CreateFormSubmit" OnCancel="@HideAllHoverForms"/>
}
@if (_productToEdit != null)
{
    <EditProduct Product="@_productToEdit" ActionName="@($"Редактировать {_productToEdit.Name}")" OnSubmit="@OnEditFormSubmit" OnCancel="@HideAllHoverForms"/>
}
@if (_productToDelete != null)
{
    <Question QuestionText="@($"Удалить {_productToDelete.Name}?")" OnSubmit="@OnDeleteFormSubmit" OnCancel="@HideAllHoverForms"/>
}

@code {
    private ICollection<ProductWithId> _products = new List<ProductWithId>();
    ProductWithId? _productToEdit;
    ProductWithId? _productToCreate;
    ProductWithId? _productToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadActualProductList();
    }
    
    private void OnAddNewProductButtonClick()
    {
        HideAllHoverForms();
        _productToCreate = new ProductWithId { Name = "", SearchQuery = "" };
        _productToEdit = null;
    }

    private void OnDeleteButtonClick(ProductWithId product)
    {
        HideAllHoverForms();
        _productToDelete = product;
    }
    
    private async Task OnDeleteFormSubmit()
    {
        if (_productToDelete == null) throw new InvalidOperationException($"{nameof(_productToDelete)} expected to be not null");
        await EbayClient.DeleteProductAsync(_productToDelete.Id);
        await LoadActualProductList();
        HideAllHoverForms();
    }

    private void OnEditButtonClick(ProductWithId product)
    {
        HideAllHoverForms();
        _productToEdit = product.Copy();
    }
    

    private async Task OnEditFormSubmit()
    {
        if (_productToEdit == null) throw new InvalidOperationException($"{nameof(_productToEdit)} expected to be not null");
        await EbayClient.UpdateProductAsync(product: _productToEdit.ToProductWithoutId(), id: _productToEdit.Id);
        HideAllHoverForms();
        await LoadActualProductList();
    }

    private async Task CreateFormSubmit()
    {
        if (_productToCreate == null) throw new InvalidOperationException($"{nameof(_productToCreate)} expected to be not null");
        await EbayClient.CreateProductAsync(_productToCreate.ToProductWithoutId());
        HideAllHoverForms();
        await LoadActualProductList();
    }
    
    private async Task LoadActualProductList()
    {
        _products = await EbayClient.GetAllProductsAsync();
    }

    private void HideAllHoverForms()
    {
        _productToDelete = null;
        _productToCreate = null;
        _productToEdit = null;
    }

}