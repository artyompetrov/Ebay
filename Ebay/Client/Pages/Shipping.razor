@page "/shippingRates"
@using Ebay.Client.Clients.Generated
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject EbayClient EbayClient

<PageTitle>Тарифы почты</PageTitle>

<h2>Тарифы почты</h2>

@foreach (var shippingType in _shippingRates)
{
    <h3 class="bg-light text-center">@shippingType.Name</h3>
    @foreach (var shippingRates in shippingType.Rates)
    {
        @if (shippingRates.SpecifiedCountries != null)
        {
            <h4>@string.Join(", ", shippingRates.SpecifiedCountries)</h4>
        }
        else
        {
            <h4>Worldwide</h4>
        }
        
        <table class="table">
            <thead>
            <tr>
                <th>Вес от</th>
                <th>Вес до</th>
                <th>Стоимость</th>
                <th>Валюта</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var shippingRate in shippingRates.Rates)
            {
                <tr>
                    <td>@shippingRate.MinWeight</td>
                    <td>@shippingRate.MaxWeight</td>
                    <td>@shippingRate.Price</td>
                    <td>@shippingType.Currency</td>
                </tr>
            }
            </tbody>
        </table>
    }
}


@code {
    private ICollection<ShippingType> _shippingRates = new List<ShippingType>();

    protected override async Task OnInitializedAsync()
    {
        await LoadActualProductList();
    }

    private async Task LoadActualProductList()
    {
        _shippingRates = await EbayClient.GetShippingRatesAsync();
        StateHasChanged();
    }

}