<div class="modal fade show" tabindex="-1" role="dialog" style="display: block;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@ActionName</h5>
            </div>
            <div class="modal-body">
                    <EditForm Model="@Product" class="">
                        <div class="form-group">
                            <label for="name">Название</label>
                            <InputText id="name" @bind-Value="Product.Name" class="form-control"/>
                        </div>
                        <div class="form-group">
                            <label for="searchQuery">Поисковый запрос</label>
                            <InputText id="searchQuery" @bind-Value="Product.SearchQuery" class="form-control"/>
                        </div>
                    </EditForm>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="@OnSubmit">Сохранить</button>
                <button type="button" class="btn btn-secondary" onclick="@OnCancel" data-dismiss="modal">Отмена</button>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show"></div>

@code {

    protected override void OnInitialized()
    {
        if (Product == null) throw new InvalidOperationException($"{nameof(Product)} Expected to be initialized");
    }

    [Parameter]
    public string ActionName { get; set; } = null!;

    [Parameter]
    public ProductWithId Product { get; set; } = null!;

    [Parameter]
    public Func<Task> OnSubmit { get; set; } = null!;

    [Parameter]
    public Action OnCancel { get; set; } = null!;

}