{
    "dependencies": {
        "@badgateway/oauth2-client": "^2.4.2",
        "@types/chrome": "^0.1.1",
        "jsonpath": "^1.1.1",
        "uuid": "^11.1.0"
    },
    "name": "chromeextension",
    "main": "index.js",
    "devDependencies": {
        "@types/jsonpath": "^0.2.4",
