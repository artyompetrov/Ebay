<!-- Do not edit manually - this file is mirrored. -->
<Project>
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Disables all Meziantou.Analyzer rules by default; needed ones are enabled selectively via .editorconfig -->
        <MeziantouAnalysisMode>None</MeziantouAnalysisMode>
        <WarningsNotAsErrors> <!-- Перечень ворнингов, которые останутся вонингами (не будут повышены до Error) -->
            NU1608, <!-- Detected package version outside of dependency constraint -->
            NU1900, <!-- Error occurred while getting package vulnerability data -->
            NU1902, <!-- Package has a known moderate severity vulnerability -->
            NU1903, <!-- Package has a known high severity vulnerability -->
            NU1603, <!-- Depends on X but X was not found. An approximate best match of X was resolved -->
            NU3005, <!-- The package signature file entry is invalid. The central directory header field 'compression method' has an invalid value -->
            NU5104, <!-- A stable release of a package should not have a prerelease dependency -->
            CS0612, <!-- A class member was marked with the Obsolete attribute -->
            CS0618, <!-- Static member was marked with the Obsolete attribute -->
            CA1305, <!-- The behavior of 'TimeSpan.ToString(string)' could vary based on the current user's locale settings -->
        </WarningsNotAsErrors>
    </PropertyGroup>
</Project>