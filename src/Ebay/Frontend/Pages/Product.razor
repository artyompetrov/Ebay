@page "/Product/{ProductId:guid}/{Tab?}"
@using Microsoft.AspNetCore.Authorization
@using System.Threading.Tasks
@attribute [Authorize]
@using Client.Clients.Generated
@inject EbayClient EbayClient
@inject NavigationManager NavigationManager

@if (_product == null)
{
    <p>Загрузка...</p>
}
else
{
    <h3>@_product.Name</h3>
    <div class="mb-3" style="display: flex; align-items: center; gap: 10px;">
        <button class="btn btn-danger btn-sm oi oi-basket" @onclick="OnDeleteClick"></button>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(GetTabClass(TabKind.LotSales))" href="@GetTabUri(TabKind.LotSales)" @onclick="() => Activate(TabKind.LotSales)" @onclick:preventDefault="true">Продажи на Ebay</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(GetTabClass(TabKind.SaleAdvertisements))" href="@GetTabUri(TabKind.SaleAdvertisements)" @onclick="() => Activate(TabKind.SaleAdvertisements)" @onclick:preventDefault="true">Предложения</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(GetTabClass(TabKind.Measurements))" href="@GetTabUri(TabKind.Measurements)" @onclick="() => Activate(TabKind.Measurements)" @onclick:preventDefault="true">Измерения</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(GetTabClass(TabKind.Parameters))" href="@GetTabUri(TabKind.Parameters)" @onclick="() => Activate(TabKind.Parameters)" @onclick:preventDefault="true">Параметры</a>
        </li>
    </ul>

    if (_activeTab == TabKind.LotSales)
    {
        <LotSales Product="_product"/>
    }
    else if (_activeTab == TabKind.SaleAdvertisements)
    {
        <SaleAdvertisements Product="_product"/>
    }
    else if (_activeTab == TabKind.Measurements)
    {
        <Measurements Product="_product"/>
    }
    else if (_activeTab == TabKind.Parameters)
    {
        <ProductProperties Product="_product" OnSuccess="OnProductUpdated"/>
    }
    
}

<QuestionPopup @ref="_questionPopup" />

@code {
    [Parameter]
    public Guid ProductId { get; set; }

    [Parameter]
    public string? Tab { get; set; }

    private ProductWithId? _product;
    private QuestionPopup _questionPopup = null!;

    private enum TabKind
    {
        LotSales,
        SaleAdvertisements,
        Measurements,
        Parameters
    }

    private TabKind _activeTab;

    protected async override Task OnParametersSetAsync()
    {
        _activeTab = Tab switch
        {
            { } t when t.Equals(nameof(TabKind.Measurements), StringComparison.OrdinalIgnoreCase) => TabKind.Measurements,
            { } t when t.Equals(nameof(TabKind.Parameters), StringComparison.OrdinalIgnoreCase) => TabKind.Parameters,
            { } t when t.Equals(nameof(TabKind.SaleAdvertisements), StringComparison.OrdinalIgnoreCase) => TabKind.SaleAdvertisements,
            { } t when t.Equals(nameof(TabKind.LotSales), StringComparison.OrdinalIgnoreCase) => TabKind.LotSales,
            _ => TabKind.LotSales
        };

        if (_product?.Id != ProductId)
        {
            _product = await EbayClient.GetProductAsync(ProductId);
        }
    }

    private void Activate(TabKind tab)
    {
        if (_activeTab == tab && string.Equals(Tab, tab.ToString(), StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _activeTab = tab;

        NavigationManager.NavigateTo(GetTabUri(tab));
    }

    private string GetTabUri(TabKind tab) => $"/Product/{ProductId}/{tab}";

    private string GetTabClass(TabKind tab) => _activeTab == tab ? "active" : string.Empty;

    private async Task OnProductUpdated()
    {
        _product = await EbayClient.GetProductAsync(ProductId);
        StateHasChanged();
    }

    private void OnDeleteClick()
    {
        var name = _product?.Name;
        var question = name != null ? $"Вы действительно хотите удалить товар '{name}'?" : "Вы действительно хотите удалить товар?";
        _questionPopup.AskQuestion(question, async () =>
        {
            await EbayClient.DeleteProductAsync(ProductId);
            NavigationManager.NavigateTo("/");
        });
    }
}
