@using Client.Extensions
@using Client.Clients.Generated
@using System.IO
@using System.Linq
@inject EbayClient EbayClientInstance

@if (_product != null)
{
    <EditForm EditContext="@_editContext">
        @FormFields
    </EditForm>
}

@code {

    private ProductWithoutId? _product;
    private Guid? _id;
    private ActionType _actionType;
    private string _oldName = null!;
    private EditContext _editContext = null!;
    private ValidationMessageStore _validationMessageStore = null!;
    private List<ProductPassportInfo> _passports = new();

    [Parameter]
    [EditorRequired]
    public Func<Task> OnSuccess { get; set; } = null!;

    [Parameter]
    public ProductWithId? Product { get; set; }

    public string? WindowHeader => _product != null ? GetWindowHeader() : null;

    protected override async Task OnParametersSetAsync()
    {
        if (Product != null && _id != Product.Id)
        {
            await StartEditAsync(Product);
        }
    }

    public void StartCreate()
    {
        _actionType = ActionType.Create;
        _product = new ProductWithoutId { Weight = 0, SearchQueries = new List<SearchQuery> { new() { Id = Guid.NewGuid() } }, RuSearchQueries = new List<RuSearchQuery>() };
        _editContext = new EditContext(_product);
        _validationMessageStore = new ValidationMessageStore(_editContext);
        StateHasChanged();
    }

    private async Task StartEditAsync(ProductWithId product)
    {
        _actionType = ActionType.Edit;
        _id = product.Id;
        _oldName = product.Name;
        _product = product.ToProductWithoutId();
        _editContext = new EditContext(_product);
        _validationMessageStore = new ValidationMessageStore(_editContext);
        await LoadPassportsAsync();
        StateHasChanged();
    }

    private async Task OnSave()
    {
        if (_product == null) throw new InvalidOperationException($"{nameof(_product)} expected to be not null");
        try
        {
            _validationMessageStore?.Clear();

            switch (_actionType)
            {
                case ActionType.Create:
                    await EbayClientInstance.CreateProductAsync(_product);
                    break;
                case ActionType.Edit:
                    if (_id == null) throw new InvalidOperationException($"{nameof(_id)} expected to be not null");
                    await EbayClientInstance.UpdateProductAsync(product: _product, id: _id.Value);
                    break;
                default:
                    throw new ArgumentOutOfRangeException();
            }

            await OnSuccess();
        }
        catch (ApiException<ValidationProblemDetailedInfo> validationError)
        {
            validationError.FillValidationMessageStore(validationMessageStore: _validationMessageStore ?? throw new NullReferenceException(nameof(_validationMessageStore)),
                model: _product ?? throw new NullReferenceException($"{nameof(_product)} expected to be not null"));
        }
    }

    public void Reset() => _product = null;

    private string GetWindowHeader()
    {
        return _actionType switch
        {
            ActionType.Create => "Создать новый продукт",
            ActionType.Edit => $"Редактировать продукт '{_oldName}'",
            _ => throw new ArgumentOutOfRangeException(nameof(_actionType))
        };
    }

    internal enum ActionType
    {
        Create = 1,
        Edit
    }

    private void AddRuSearchQuery()
    {
        if (_product == null) throw new InvalidOperationException($"{nameof(_product)} expected to be not null");
        _product.RuSearchQueries.Add(new RuSearchQuery() { Id = Guid.NewGuid() });
    }

    private void AddSearchQuery()
    {
        if (_product == null) throw new InvalidOperationException($"{nameof(_product)} expected to be not null");
        _product.SearchQueries.Add(new SearchQuery() { Id = Guid.NewGuid() });
    }

    private void RemoveRuSearchQuery(RuSearchQuery query)
    {
        if (_product == null) throw new InvalidOperationException($"{nameof(_product)} expected to be not null");
        _product.RuSearchQueries.Remove(query);
    }

    private void RemoveSearchQuery(SearchQuery query)
    {
        if (_product == null) throw new InvalidOperationException($"{nameof(_product)} expected to be not null");
        _product.SearchQueries.Remove(query);
    }

    private async Task LoadPassportsAsync()
    {
        if (_id == null)
        {
            _passports = new List<ProductPassportInfo>();
            return;
        }

        var passports = await EbayClientInstance.GetProductPassportsAsync(_id.Value);
        _passports = passports.OrderBy(x => x.Order).ToList();
    }

    private async Task OnPassportSelected(InputFileChangeEventArgs e)
    {
        if (_id == null)
            return;

        foreach (var file in e.GetMultipleFiles())
        {
            await using var stream = file.OpenReadStream(long.MaxValue);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            await EbayClientInstance.UploadProductPassportAsync(
                new ProductPassportUpload
                {
                    File = ms.ToArray(),
                    FileName = file.Name,
                    ContentType = file.ContentType
                },
                _id.Value);
        }

        await LoadPassportsAsync();
    }

    private async Task DeletePassport(Guid passportId)
    {
        if (_id == null)
            return;

        await EbayClientInstance.DeleteProductPassportAsync(_id.Value, passportId);
        await LoadPassportsAsync();
    }

    private async Task MovePassport(ProductPassportInfo passport, int delta)
    {
        if (_id == null)
            return;

        var newOrder = passport.Order + delta;
        var swap = _passports.FirstOrDefault(p => p.Order == newOrder);
        if (swap != null)
        {
            await EbayClientInstance.UpdateProductPassportAsync(
                new ProductPassportUpdate { Order = passport.Order },
                _id.Value,
                swap.Id);
        }

        await EbayClientInstance.UpdateProductPassportAsync(
            new ProductPassportUpdate { Order = newOrder },
            _id.Value,
            passport.Id);

        await LoadPassportsAsync();
    }

    private string GetPassportUrl(Guid passportId) => $"{EbayClientInstance.BaseUrl}products/{_id}/passports/{passportId}";

    private RenderFragment FormFields => @<div class="row">
        <div class="col-md-6 pe-4 border-end border-secondary">
            <h4>Параметры</h4>
            <div class="form-group">
                <label for="name">Название товара</label>
                <InputText id="name" @bind-Value="_product!.Name" class="form-control" />
                <ValidationMessage For="@(() => _product!.Name)" />
            </div>

            <div class="form-group">
                <label for="weight">Вес без упаковки (грамм)</label>
                <InputNumber id="weight" @bind-Value="_product!.Weight" class="form-control" />
                <ValidationMessage For="@(() => _product!.Weight)" />
            </div>
            <hr />
            @{
                var ruSearchQueryNumber = 1;
            }
            @foreach (var query in _product!.RuSearchQueries)
            {
                <div class="form-group">
                    <label for="@($"ruSearchQuery_{ruSearchQueryNumber}")">Дополнительное имя</label>
                    <InputText id="@($"ruSearchQuery_{ruSearchQueryNumber}")" @bind-Value="query.Query" class="form-control" />
                    @if (ruSearchQueryNumber > 0)
                    {
                        <button class="btn btn-primary btn-sm" @onclick="() => RemoveRuSearchQuery(query)">Удалить</button>
                    }
                </div>
                ruSearchQueryNumber++;
            }
            <br />
            <button class="btn btn-primary btn-sm" @onclick="AddRuSearchQuery">Добавить дополнительное имя</button>
            <hr />
            @{
                var searchQueryNumber = 1;
            }
            @foreach (var query in _product!.SearchQueries)
            {
                <div class="form-group">
                    <label for="@($"searchQuery_{searchQueryNumber}")">Поисковый запрос ebay</label>
                    <InputText id="@($"searchQuery_{searchQueryNumber}")" @bind-Value="query.Query" class="form-control" />
                    @if (searchQueryNumber > 1)
                    {
                        <button class="btn btn-primary btn-sm" @onclick="() => RemoveSearchQuery(query)">Удалить</button>
                    }
                </div>
                searchQueryNumber++;
            }
            <br />
            <button class="btn btn-primary btn-sm" @onclick="AddSearchQuery">Добавить поисковый запрос ebay</button>
            <hr />
            <div class="mt-3">
                <button class="btn btn-primary" @onclick="OnSave" type="button">Сохранить</button>
            </div>
        </div>
        <div class="col-md-6 ps-4">
            <h4>Паспорта</h4>
            <div class="form-group">
                @{
                    var minOrder = _passports.Count > 0 ? _passports.Min(p => p.Order) : 0;
                    var maxOrder = _passports.Count > 0 ? _passports.Max(p => p.Order) : 0;
                }
                <div>
                    @foreach (var passport in _passports.OrderBy(p => p.Order))
                    {
                        <div class="mb-1">
                            <a href="@GetPassportUrl(passport.Id)" target="_blank">@passport.FileName</a>
                            <button class="btn btn-primary btn-sm ms-2" @onclick="() => MovePassport(passport, -1)" disabled="@(passport.Order == minOrder)">↑</button>
                            <button class="btn btn-primary btn-sm ms-1" @onclick="() => MovePassport(passport, 1)" disabled="@(passport.Order == maxOrder)">↓</button>
                            <button class="btn btn-danger btn-sm ms-1" @onclick="() => DeletePassport(passport.Id)">Удалить</button>
                        </div>
                    }
                </div>
                <InputFile OnChange="OnPassportSelected" multiple accept="image/*" />
            </div>
        </div>
    </div>;
}
