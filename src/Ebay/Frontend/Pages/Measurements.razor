@using Client.Clients.Generated
@using System.Collections.Generic
@using System.Collections.ObjectModel
@using System.Globalization
@using System.Linq
@using Client.Extensions
@using Microsoft.AspNetCore.Authorization
@using Newtonsoft.Json
@attribute [Authorize]
@inject EbayClient EbayClient
@inject ILogger<Measurements> Logger
@inject IHttpClientFactory HttpClientFactory

<script src="https://unpkg.com/html5-qrcode"></script>
<style>
    #reader video {
        transform: scaleX(-1); /* зеркалирование по горизонтали */
    }
    #typeSelect {
        width: 300px;
    }
    #monthInput {
        width: 300px;
    }

    .chip {
        border-radius: 0.375rem;
        padding: 0.125rem 0.5rem;
        display: inline-block;
    }

    .chip.table-success,
    .chip.table-warning,
    .chip.table-danger {
        background-color: var(--bs-table-bg);
        color: var(--bs-table-color);
    }

    .similar-measurements li + li {
        margin-top: 0.25rem;
    }

    .similar-measurement {
        border-radius: 0.375rem;
        padding: 0.125rem 0.5rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        width: fit-content;
    }

    .similar-measurement.table-success,
    .similar-measurement.table-warning,
    .similar-measurement.table-danger {
        background-color: var(--bs-table-bg);
        color: var(--bs-table-color);
    }

    .similar-measurement > a {
        color: inherit;
        text-decoration: none;
    }

    .similar-measurement > a:hover,
    .similar-measurement > a:focus {
        text-decoration: underline;
    }

    .match-group-a {
        background-color: #f9fafc;
    }

    .match-group-b {
        background-color: #eef3ff;
    }

    .table-super-success {
        background-color: #51cb94 !important; /* тёмно-зелёный (Forest Green) */
    }
</style>

    <div class="row">
        <div class="col-md-6 pe-4 border-end border-secondary">
            <h4>Добавить замер</h4>
            <div id="reader" style="width: 500px;"></div>
            @if (_error != null)
            {
                <p style="color:red">@_error</p>
            }

            @if (_message != null)
            {
                <p style="color:green">@_message</p>
            }
            <br>
            <label for="typeSelect">Тип измерения:</label>
            <select id="typeSelect" class="form-control" @bind="_selectedState">
                <option value="">-- выберите тип --</option>
                @foreach (var state in _productStates)
                {
                    <option value="@state">@state</option>
                }
            </select>
            <br>
            <label for="manufactureCodeInput">Код или дата производства в формате yyyy-mm:</label>
            <input id="manufactureCodeInput" @bind="_manufactureCode" type="text" class="form-control" lang="en" />
            
            <br>
            <InputFile OnChange="HandleFileSelected" accept=".zip" />
        </div>
        <div class="col-md-6 ps-4">
            <h4>Рабочая точка</h4>
            @if (_isWorkingPointLoading)
            {
                <p>Загрузка...</p>
            }
            else
            {
                if (!string.IsNullOrWhiteSpace(_workingPointLoadError))
                {
                    <p class="text-danger">@_workingPointLoadError</p>
                }

                if (!string.IsNullOrWhiteSpace(_workingPointSaveError))
                {
                    <p class="text-danger">@_workingPointSaveError</p>
                }

                if (!string.IsNullOrWhiteSpace(_workingPointSaveMessage))
                {
                    <p class="text-success">@_workingPointSaveMessage</p>
                }

                <div class="row g-2">
                    <div class="col-sm-6">
                        <label class="form-label">Напряжение анода, В</label>
                        <InputNumber @bind-Value="_tubeWorkingPoint.AnodeVoltage" class="form-control" Step="any" Min="0.0000001" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Полуширина по аноду, В</label>
                        <InputNumber @bind-Value="_tubeWorkingPoint.AnodeVoltageHalfWidth" class="form-control" Step="any" Min="0.0000001" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Напряжение сетки, В</label>
                        <InputNumber @bind-Value="_tubeWorkingPoint.GridVoltage" class="form-control" Step="any" Max="-0.0000001" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Полуширина по сетке, В</label>
                        <InputNumber @bind-Value="_tubeWorkingPoint.GridVoltageHalfWidth" class="form-control" Step="any" Min="0.0000001" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Номинальный ток, мА</label>
                        <InputNumber @bind-Value="_tubeWorkingPoint.NominalCurrent" class="form-control" Step="any" Min="0.0000001" />
                    </div>
                </div>
                <button class="btn btn-primary btn-sm mt-2" @onclick="OnSaveWorkingPointAsync" disabled="@(_isSavingWorkingPoint || _isWorkingPointLoading || !IsWorkingPointValid())">
                    @if (_isSavingWorkingPoint)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Сохранить
                </button>
            }
            <hr class="my-4" />
            <h4>Подбор комплектов</h4>
            @if (!string.IsNullOrWhiteSpace(_matchingError))
            {
                <p class="text-danger">@_matchingError</p>
            }
            <button class="btn btn-primary btn-sm" @onclick="OnFindMatchedClick" disabled="@(_isWorkingPointLoading || !_hasWorkingPoint || !IsWorkingPointValid())">Подобрать</button>
        </div>
    </div>
<br>
<div class="mb-3">
    <h4>Лоты для продажи</h4>

    @if (!string.IsNullOrWhiteSpace(_lotForSaleError))
    {
        <p class="text-danger">@_lotForSaleError</p>
    }

    <div class="row g-2 align-items-end">
        <div class="col-sm-3">
            <label class="form-label">Lot ID</label>
            <InputText class="form-control" @bind-Value="_newLotForSaleId" maxlength="7" />
        </div>
        <div class="col-sm-5">
            <label class="form-label">Название</label>
            <InputText class="form-control" @bind-Value="_newLotForSaleName" />
        </div>
        <div class="col-sm-4">
            <button class="btn btn-primary btn-sm" @onclick="CreateLotForSaleAsync" disabled="@_isCreatingLotForSale">Создать лот</button>
        </div>
    </div>
</div>

@if (_lotForSales is not null)
{
    foreach (var lot in _lotForSales)
    {
        var lotIdPart = $"&lotId={lot.Id}";
        <NavLink class="btn btn-primary btn-sm" href="@($"/ebay_description/{ProductId}?measurementState={MeasurementState.Created}&state={ProductState.New}{lotIdPart}")" target="_blank">@lot.Name (New)</NavLink>
        <NavLink class="btn btn-primary btn-sm" href="@($"/ebay_description/{ProductId}?measurementState={MeasurementState.Created}&state={ProductState.Used}{lotIdPart}")" target="_blank">@lot.Name (Used)</NavLink>
        <br>
        <br>
    }
}
@if (_measurements != null)
{
<h3>Зарегистрированные замеры:</h3>
    <div class="mb-3">
        <span class="form-label d-block">Фильтр по статусу:</span>
        <div class="d-flex flex-wrap gap-3">
            @foreach (var state in _measurementStates)
            {
                var checkboxId = GetStateFilterId(state);
                <div class="form-check form-check-inline">
                    <input class="form-check-input"
                           type="checkbox"
                           id="@checkboxId"
                           checked="@_selectedMeasurementStates.Contains(state)"
                           @onchange="e => OnMeasurementFilterChanged(state, (bool?)e.Value == true)" />
                    <label class="form-check-label" for="@checkboxId">
                        @GetMeasurementStateEmoji(state) @state.ToString("G")
                    </label>
                </div>
            }
        </div>
    </div>
    <table class="table">
        <thead>
        <tr>
            <th>Название</th>
            <th>Код</th>
            <th>Состояние</th>
            <th>Статус</th>
            <th>Опубликован на eBay</th>
            <th>Расположение</th>
            <th>Lot ID</th>
            <th>Match ID</th>
            <th>Баланс</th>
            <th>Похожие</th>
            <th></th>
        </tr>
        </thead>
        <tbody>

        @{
            string? previousMatchId = null;
            bool useAlternateMatchColor = false;
        }

        @foreach (var measurement in _measurements)
        {
            if (measurement.MatchId != previousMatchId)
            {
                useAlternateMatchColor = !useAlternateMatchColor;
                previousMatchId = measurement.MatchId;
            }

            var matchRowClass = useAlternateMatchColor ? "match-group-b" : "match-group-a";

            <tr class="@matchRowClass">
                <td><NavLink href="@($"m/{measurement.MeasurementId}")" target="_blank">#@measurement.MeasurementId</NavLink></td>
                <td>
                    <input type="text"
                           class="form-control"
                           value="@measurement.ManufactureCode"
                           @oninput="async e => await OnManufactureCodeChanged(measurement, e.Value?.ToString())" />
                </td>
                <td>@measurement.ProductState.ToString("G")</td>
                <td>
                    <select class="form-select"
                            value="@measurement.MeasurementState"
                            @onchange="async e => await OnMeasurementStateChanged(measurement, Enum.Parse<MeasurementState>(e.Value!.ToString()!))">
                        @foreach (var state in _measurementStates)
                        {
                            <option value="@state" selected="@(state == measurement.MeasurementState)">
                                @GetMeasurementStateEmoji(state) @state.ToString("G")
                            </option>
                        }
                    </select>
                </td>
                <td class="text-center">
                    <input type="checkbox" class="form-check-input" disabled checked="@(measurement.IsPublishedOnEbay == true)" />
                </td>
                <td>
                    <input type="text"
                           class="form-control"
                           value="@measurement.Location"
                           @oninput="async e => await OnLocationChanged(measurement, e.Value?.ToString())" />
                </td>
                <td>
                    <input type="text"
                           class="form-control"
                           value="@measurement.LotId"
                           @oninput="async e => await OnLotIdChanged(measurement, e.Value?.ToString())" />
                </td>
                <td>
                    <input type="text"
                           class="form-control"
                           value="@measurement.MatchId"
                           @oninput="async e => await OnMatchIdChanged(measurement, e.Value?.ToString())" />
                </td>
                <td class="@GetPercentCellClass(measurement.DoubleTriodeSectionRmse)">
                    @FormatPercent(measurement.DoubleTriodeSectionRmse)
                </td>
                <td>
                    @if (measurement.SimilarMeasurements?.Any() == true)
                    {
                        <ul class="similar-measurements list-unstyled mb-0">
                            @foreach (var similar in measurement.SimilarMeasurements)
                            {
                                <li>
                                    <div class="similar-measurement" >
                                        <a title="Общий скор (чем меньше тем луче): @similar.Score" class=@($"chip {GetPercentCellClass(similar.Score)}") href="@($"m/{similar.MeasurementId}")" target="_blank">@similar.MeasurementId</a>
                                        <span title="Дата производства (если одинаковая то лучше)" class="chip @GetManufactureCodeCellClass(similar.SameDate)">@similar.ManufactureCode</span>
                                        <span title="Средневатратичная ошибка между первыми секциями (чем меньше тем лучше)" class="chip @GetPercentCellClass(similar.RmseSection1)">S1: @FormatPercent(similar.RmseSection1)</span>
                                        @if (similar.RmseSection2.HasValue)
                                        {
                                            <span title="Средневатратичная ошибка между вторыми секциями (чем меньше тем лучше)" class="chip @GetPercentCellClass(similar.RmseSection2)">S2: @FormatPercent(similar.RmseSection2)</span>
                                        }
                                        @if (measurement.DoubleTriodeSectionRmse != null)
                                        {
                                            var balanceError = measurement.DoubleTriodeSectionRmse - similar.DoubleTriodeSectionRmse;
                                            balanceError = balanceError == null ? null : Math.Abs(balanceError.Value);
                                            <span title="Разница баланса первой и второй лампы (чем меньше тем лучше)" class="chip @GetPercentCellClass(balanceError)">B: @FormatPercent(balanceError)</span>
                                        }
                                        @if (similar.IsCrossMatch)
                                        {
                                            <span class="chip table-danger">Cross-match</span>
                                        }
                                        @if (similar.MatchId != null)
                                        {
                                            if (similar.IsMatchedPair)
                                            {
                                                <span class="chip table-success">Matched</span>
                                            }
                                            else
                                            {
                                                <span class="chip table-warning">@similar.MatchId</span>
                                            }
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td><button class="btn btn-danger btn-sm oi oi-basket" @onclick="@(e => OnDeleteButtonClick(measurement.MeasurementId))"></button></td>
            </tr>
        }
        </tbody>
    </table>
}

<QuestionPopup @ref="_questionPopup"/>

@code {
    private string? _error;
    private string? _message;
    private ProductState? _selectedState;
    private List<ProductState> _productStates = Enum.GetValues(typeof(ProductState)).Cast<ProductState>().ToList();
    private List<MeasurementState> _measurementStates = Enum.GetValues(typeof(MeasurementState)).Cast<MeasurementState>().ToList();
    private HashSet<MeasurementState> _selectedMeasurementStates = new()
    {
        MeasurementState.Created,
        MeasurementState.Selling
    };
    private List<MeasurementData>? _allMeasurements;
    private ICollection<MeasurementData>? _measurements;
    private QuestionPopup _questionPopup = null!;
    private string? _manufactureCode;
    private TubeWorkingPoint _tubeWorkingPoint = new();
    private bool _isWorkingPointLoading;
    private bool _isSavingWorkingPoint;
    private string? _workingPointLoadError;
    private string? _workingPointSaveError;
    private string? _workingPointSaveMessage;
    private string? _matchingError;
    private bool _hasWorkingPoint;
    private ReadOnlyCollection<LotForSaleResponse>? _lotForSales;
    private WebApiClient? _webApiClient;
    private string _newLotForSaleId = string.Empty;
    private string _newLotForSaleName = string.Empty;
    private bool _isCreatingLotForSale;
    private string? _lotForSaleError;

    [Parameter]
    public ProductWithId Product { get; set; } = null!;

    private Guid ProductId => Product.Id;

    protected async override Task OnParametersSetAsync()
    {
        _workingPointSaveError = null;
        _workingPointSaveMessage = null;
        _tubeWorkingPoint = new();
        _matchingError = null;
        _hasWorkingPoint = false;

        _webApiClient = new WebApiClient(EbayClient.BaseUrl, HttpClientFactory.CreateClient("ServerAPI"));
        await LoadLotForSales();
        await LoadTubeWorkingPointAsync();
        await UpdateMeasurementsAsync();
    }

    private async Task LoadLotForSales()
    {
        if (_webApiClient is null)
        {
            return;
        }

        var lotForSales = await _webApiClient.GetLotForSalesAsync();
        _lotForSales = lotForSales
            .Where(x => x.ProductId == ProductId)
            .OrderBy(x => x.Id)
            .ToList()
            .AsReadOnly();
    }


    private async Task CreateLotForSaleAsync()
    {
        if (_webApiClient is null)
        {
            _lotForSaleError = "WebApi клиент не инициализирован.";
            return;
        }

        try
        {
            _lotForSaleError = null;
            _isCreatingLotForSale = true;

            var lotId = _newLotForSaleId.Trim();
            var lotName = _newLotForSaleName.Trim();

            await _webApiClient.CreateLotForSaleAsync(new LotForSaleCreateRequest
            {
                Id = lotId,
                Name = lotName,
                ProductId = ProductId
            });

            _newLotForSaleId = string.Empty;
            _newLotForSaleName = string.Empty;
            await LoadLotForSales();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating lot for sale for product {ProductId}", ProductId);
            _lotForSaleError = "Ошибка при создании лота для продажи.";
        }
        finally
        {
            _isCreatingLotForSale = false;
        }
    }

    private async Task UpdateMeasurementsAsync()
    {
        _allMeasurements = (await EbayClient.GetMeasurementsAsync(null, ProductId)).ToList();
        ApplyMeasurementFilters();
    }

    private void OnMeasurementFilterChanged(MeasurementState state, bool isSelected)
    {
        if (isSelected)
        {
            _selectedMeasurementStates.Add(state);
        }
        else
        {
            _selectedMeasurementStates.Remove(state);
        }

        ApplyMeasurementFilters();
    }

    private void ApplyMeasurementFilters()
    {
        if (_allMeasurements is null)
        {
            _measurements = null;
            StateHasChanged();
            return;
        }

        if (_selectedMeasurementStates.Count == 0)
        {
            _measurements = Array.Empty<MeasurementData>();
            StateHasChanged();
            return;
        }

        _measurements = _allMeasurements
            .Where(measurement => _selectedMeasurementStates.Contains(measurement.MeasurementState))
            .ToList();

        StateHasChanged();
    }

    private async Task LoadTubeWorkingPointAsync()
    {
        _isWorkingPointLoading = true;
        _workingPointLoadError = null;
        _hasWorkingPoint = false;

        try
        {
            var workingPoint = await EbayClient.GetTubeWorkingPointAsync(ProductId);
            _tubeWorkingPoint = workingPoint ?? new TubeWorkingPoint();
            _hasWorkingPoint = workingPoint is not null;
        }
        catch (ApiException ex) when (ex.StatusCode == 400)
        {
            _tubeWorkingPoint = new TubeWorkingPoint();
            _hasWorkingPoint = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load tube working point for product {ProductId}", ProductId);
            _workingPointLoadError = "Не удалось загрузить рабочую точку.";
        }
        finally
        {
            _isWorkingPointLoading = false;
        }
    }

    private async Task OnSaveWorkingPointAsync()
    {
        if (_isSavingWorkingPoint)
        {
            return;
        }

        if (!IsWorkingPointValid())
        {
            _workingPointSaveError = "Введите значения больше 0.";
            _workingPointSaveMessage = null;
            return;
        }

        _isSavingWorkingPoint = true;
        _workingPointSaveError = null;
        _workingPointSaveMessage = null;

        try
        {
            await EbayClient.UpsertTubeWorkingPointAsync(_tubeWorkingPoint, ProductId);
            _workingPointSaveMessage = "Рабочая точка сохранена.";
            _workingPointLoadError = null;
            _hasWorkingPoint = true;
            _matchingError = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save tube working point for product {ProductId}", ProductId);
            _workingPointSaveError = "Не удалось сохранить рабочую точку.";
        }
        finally
        {
            _isSavingWorkingPoint = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            _message = null;
            _error = null;

            var file = e.File;

            if (!file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
            {
                _error = "Разрешены только zip файлы";
                return;
            }

            if (file.ContentType != "application/zip" && file.ContentType != "application/x-zip-compressed")
            {
                _error = $"Невалидный MIME type: {file.ContentType}";
                return;
            }

            var qrCodeData = await Interop.StartQrScanner();
            var id = qrCodeData.Split('/').Last();

            await using var stream = file.OpenReadStream();
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            await EbayClient.UploadMeasurementAsync(
                measurementData: new MeasurementDataToUpload
                {
                    File = ms.ToArray(),
                    MeasurementId = id,
                    ManufactureCode = _manufactureCode,
                    ProductState = _selectedState ?? throw new InvalidOperationException("Тип измерения не выбран"),
                },
                Product.Id,
                CancellationToken.None);

            _message = $"Успешно загружен {id}";
        }
        catch (ApiException<ValidationProblemDetailedInfo> ex)
        {
            _error = JsonConvert.SerializeObject(ex.Result);
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }

        await UpdateMeasurementsAsync();
    }

    private void OnDeleteButtonClick(string measurementMeasurementId)
    {
        _questionPopup.AskQuestion(
            $"Вы действительно хотите удалить измерение '{measurementMeasurementId}'?",
            async () =>
            {
                await EbayClient.DeleteMeasurementAsync(ProductId, measurementMeasurementId);
                await UpdateMeasurementsAsync();
            });
    }

    private async Task OnLocationChanged(MeasurementData measurement, string? newValue)
    {
        try
        {
            measurement.Location = newValue;
            await EbayClient.UpdateMeasurementLocationAsync(newValue, ProductId, measurement.MeasurementId);
            Logger.LogInformation("Updated note for {Id}: {Note}", measurement.MeasurementId, newValue);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating note for {Id}", measurement.MeasurementId);
            _error = "Ошибка при обновлении заметки";
        }
    }

    private async Task OnManufactureCodeChanged(MeasurementData measurement, string? newValue)
    {
        var previousValue = measurement.ManufactureCode;

        try
        {
            var updatedValue = (newValue ?? string.Empty).Trim();

            measurement.ManufactureCode = updatedValue;
            await EbayClient.UpdateMeasurementManufactureCodeAsync(updatedValue, ProductId, measurement.MeasurementId);
            _error = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating manufacture code for {Id}", measurement.MeasurementId);
            measurement.ManufactureCode = previousValue;
            _error = "Ошибка при обновлении кода измерения";
        }
    }

    private async Task OnMatchIdChanged(MeasurementData measurement, string? newValue)
    {
        try
        {
            measurement.MatchId = newValue;
            await EbayClient.UpdateMeasurementMatchIdAsync(newValue, ProductId, measurement.MeasurementId);
            Logger.LogInformation("Updated Match Id for {Id}: {Match}", measurement.MeasurementId, newValue);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating match id for {Id}", measurement.MeasurementId);
            _error = "Ошибка при обновлении match id";
        }
    }

    private async Task OnLotIdChanged(MeasurementData measurement, string? newValue)
    {
        try
        {
            var lotId = string.IsNullOrWhiteSpace(newValue) ? null : newValue.Trim();

            measurement.LotId = lotId;
            await EbayClient.UpdateMeasurementLotIdAsync(lotId, ProductId, measurement.MeasurementId);
            Logger.LogInformation("Updated Lot Id for {Id}: {Lot}", measurement.MeasurementId, lotId);
            _error = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating lot id for {Id}", measurement.MeasurementId);
            _error = "Ошибка при обновлении lot id";
        }
    }

    private bool IsWorkingPointValid()
    {
        return _tubeWorkingPoint.AnodeVoltage > 0
            && _tubeWorkingPoint.GridVoltage < 0
            && _tubeWorkingPoint.AnodeVoltageHalfWidth > 0
            && _tubeWorkingPoint.GridVoltageHalfWidth > 0
            && _tubeWorkingPoint.NominalCurrent > 0;
    }

    private void OnFindMatchedClick()
    {
        if (_isWorkingPointLoading)
        {
            _matchingError = "Дождитесь загрузки рабочей точки.";
            return;
        }

        if (!IsWorkingPointValid())
        {
            _matchingError = "Введите корректные значения рабочей точки.";
            return;
        }

        if (!_hasWorkingPoint)
        {
            _matchingError = "Сохраните рабочую точку перед подбором.";
            return;
        }

        _matchingError = null;

        _questionPopup.AskQuestion(
            questionText: "Подобрать комплект?",
            async () =>
            {
                if (_isWorkingPointLoading)
                {
                    _matchingError = "Дождитесь загрузки рабочей точки.";
                    StateHasChanged();
                    return;
                }

                if (!IsWorkingPointValid())
                {
                    _matchingError = "Введите корректные значения рабочей точки.";
                    StateHasChanged();
                    return;
                }

                if (!_hasWorkingPoint)
                {
                    _matchingError = "Сохраните рабочую точку перед подбором.";
                    StateHasChanged();
                    return;
                }

                try
                {
                    await EbayClient.FindMatchedMeasurementsAsync(Product.Id);
                    _matchingError = null;
                    await UpdateMeasurementsAsync();
                }
                catch (ApiException<ValidationProblemDetailedInfo> ex)
                {
                    var firstError = ex.Result
                        .Parse()
                        .SelectMany(parsed => parsed.Errors)
                        .FirstOrDefault();
                    _matchingError = firstError ?? "Не удалось отправить задачу на подбор.";
                    Logger.LogWarning(ex, "Validation error when sending matched measurements request for product {ProductId}", ProductId);
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to send matched measurements request for product {ProductId}", ProductId);
                    _matchingError = "Не удалось отправить задачу на подбор.";
                    StateHasChanged();
                }
            });
    }

    private async Task OnMeasurementStateChanged(MeasurementData measurement, MeasurementState newState)
    {
        try
        {
            measurement.MeasurementState = newState;
            await EbayClient.UpdateMeasurementStateAsync(newState, ProductId, measurement.MeasurementId);
            Logger.LogInformation("Updated state for {Id}: {State}", measurement.MeasurementId, newState);
            ApplyMeasurementFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating state for {Id}", measurement.MeasurementId);
            _error = "Ошибка при обновлении статуса";
        }
    }

    private static string GetStateFilterId(MeasurementState state) => $"stateFilter_{state:G}";

    private static string GetManufactureCodeCellClass(bool sameCode) => sameCode ? "table-super-success" : "table-warning";

    private static string? GetPercentCellClass(double? balance)
    {
        if (!balance.HasValue)
        {
            return null;
        }

        if (balance.Value < 10)
        {
            return "table-super-success";
        }
        
        if (balance.Value < 20)
        {
            return "table-success";
        }

        if (balance.Value < 30)
        {
            return "table-warning";
        }

        return "table-danger";
    }

    private static string? FormatPercent(double? balance)
    {
        return balance.HasValue
            ? string.Format(CultureInfo.InvariantCulture, "{0:0.##}%", balance.Value)
            : null;
    }

    private static string GetMeasurementStateEmoji(MeasurementState state)
    {
        return state switch
        {
            MeasurementState.Created => "\uD83C\uDD95",
            MeasurementState.Selling => "\uD83D\uDED2",
            MeasurementState.Sold => "\u2705",
            _ => string.Empty
        };
    }
}
