@page "/dogs"
@using System.Text.Json.Serialization
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Случайные собаки</PageTitle>

<h2>Случайные собаки</h2>

<div style="margin-bottom: 1rem; display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
    <button class="btn btn-primary" @onclick="LoadRandomDog" disabled="@_loading">
        @(_loading ? "Загрузка..." : "Следующий пёс")
    </button>
    <div class="form-check form-switch" style="margin: 0; display: flex; align-items: center; gap: 0.25rem;">
        <input class="form-check-input" type="checkbox" id="autoSwitch"
               checked="@_autoPlay"
               @onchange="OnAutoPlayToggled" />
        <label class="form-check-label" for="autoSwitch">Авто</label>
    </div>
    @if (_autoPlay)
    {
        <select class="form-select form-select-sm" style="width: auto;"
                @onchange="OnIntervalChanged">
            <option value="2">2 сек</option>
            <option value="5" selected>5 сек</option>
            <option value="10">10 сек</option>
        </select>
    }
</div>

@if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_imageUrl != null)
{
    <div style="max-width: 600px;">
        <img src="@_imageUrl"
             alt="Случайная собака"
             style="width: 100%; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.2);"
             @key="_imageUrl" />
        @if (_breed != null)
        {
            <p style="margin-top: 0.5rem; color: #666; font-style: italic;">Порода: @_breed</p>
        }
    </div>
}

@code {
    private string? _imageUrl;
    private string? _breed;
    private string? _error;
    private bool _loading;
    private bool _autoPlay;
    private int _intervalSeconds = 5;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadRandomDog();
    }

    private async Task LoadRandomDog()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("DogApi");
            var response = await client.GetFromJsonAsync<DogApiResponse>("breeds/image/random");
            if (response?.Status == "success" && response.Message != null)
            {
                _imageUrl = response.Message;
                _breed = ExtractBreed(response.Message);
            }
        }
        catch (Exception ex)
        {
            _error = $"Не удалось загрузить изображение: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private static string? ExtractBreed(string url)
    {
        var parts = url.Split('/');
        var breedsIndex = Array.IndexOf(parts, "breeds");
        if (breedsIndex >= 0 && breedsIndex + 1 < parts.Length)
        {
            return string.Join(" ", parts[breedsIndex + 1]
                .Split('-')
                .Select(s => s.Length > 0 ? char.ToUpper(s[0]) + s[1..] : s));
        }
        return null;
    }

    private async Task OnAutoPlayToggled(ChangeEventArgs e)
    {
        _autoPlay = (bool)(e.Value ?? false);
        _timer?.Dispose();
        _timer = null;

        if (_autoPlay)
        {
            _timer = new System.Threading.Timer(
                async _ =>
                {
                    await InvokeAsync(LoadRandomDog);
                },
                state: null,
                dueTime: _intervalSeconds * 1000,
                period: _intervalSeconds * 1000);
        }

        await Task.CompletedTask;
    }

    private void OnIntervalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var seconds))
        {
            _intervalSeconds = seconds;
            if (_autoPlay && _timer != null)
            {
                _timer.Change(_intervalSeconds * 1000, _intervalSeconds * 1000);
            }
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private record DogApiResponse(
        [property: JsonPropertyName("message")] string? Message,
        [property: JsonPropertyName("status")] string? Status
    );
}
