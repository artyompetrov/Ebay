@page "/cats"

<PageTitle>Котики</PageTitle>

<h1>Котики</h1>

<p>Нажмите кнопку, чтобы посмотреть случайную картинку котика.</p>

<button class="btn btn-primary" @onclick="LoadNextCatImageAsync" disabled="@_isLoading">
    @(_isLoading ? "Загружаю..." : "Показать другого котика")
</button>

@if (!string.IsNullOrWhiteSpace(_catImageUrl))
{
    <div class="mt-3">
        <img src="@_catImageUrl" alt="Случайный котик" class="img-fluid rounded shadow-sm" />
    </div>
}

@code {
    private string? _catImageUrl;
    private bool _isLoading;

    protected override Task OnInitializedAsync() => LoadNextCatImageAsync();

    private Task LoadNextCatImageAsync()
    {
        _isLoading = true;
        _catImageUrl = $"https://cataas.com/cat?width=900&height=600&_t={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";
        _isLoading = false;

        return Task.CompletedTask;
    }
}
