@page "/measurement-photos"
@page "/measurement-photos/{MeasurementId}"
@using Client.Clients.Generated
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject WebApiClient WebApiClient
@inject ILogger<MeasurementPhotos> Logger

<script src="https://unpkg.com/html5-qrcode"></script>
<style>
    #reader video {
        transform: scaleX(-1);
    }

    .measurement-photo-thumbnail {
        width: 64px;
        height: 64px;
        object-fit: cover;
    }

    .photo-hover {
        position: relative;
        display: inline-block;
    }

    .photo-hover-toggle {
        display: none;
    }

    .photo-hover-thumb-label {
        display: block;
        margin: 0;
        cursor: pointer;
    }

    .photo-hover-backdrop {
        display: none;
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        background: rgba(0, 0, 0, 0.6);
        z-index: 999;
    }

    .photo-hover-toggle:checked ~ .photo-hover-backdrop {
        display: block;
    }

    .photo-hover-full {
        display: block;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        max-width: 90vw;
        max-height: 90vh;
        width: auto;
        height: auto;
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        z-index: 1000;
        border: 2px solid #ccc;
        background: #fff;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
    }

    .photo-hover:hover .photo-hover-full,
    .photo-hover-toggle:checked ~ .photo-hover-full {
        visibility: visible;
        opacity: 1;
    }
</style>

<h3>Фото измерений</h3>

<p>
    Сканируйте штрихкод на карточке измерения, затем загружайте фото прямо с камеры телефона.
</p>

<div class="row g-3">
    <div class="col-lg-5">
        <h5>1) Сканирование штрихкода</h5>
        <div id="reader" style="width: 100%; max-width: 420px;"></div>
        <button class="btn btn-primary btn-sm mt-2" @onclick="ScanBarcodeAsync" disabled="@_isScanning">
            @(_isScanning ? "Сканирование..." : "Сканировать")
        </button>

        @if (!string.IsNullOrWhiteSpace(_measurementId))
        {
            <p class="mt-2 mb-0">Найдено измерение: <strong>@_measurementId</strong></p>
        }
    </div>
    <div class="col-lg-7">
        <h5>2) Фото</h5>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="text-danger">@_error</p>
        }

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="text-success">@_message</p>
        }

        <div class="mb-2">
            <InputFile OnChange="OnPhotosSelectedAsync" multiple accept="image/*" capture="environment" disabled="@string.IsNullOrWhiteSpace(_measurementId)" />
        </div>

        @if (string.IsNullOrWhiteSpace(_measurementId))
        {
            <p class="text-muted">Сначала отсканируйте штрихкод.</p>
        }
        else if (_photos.Count == 0)
        {
            <p class="text-muted">Фотографий пока нет.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var photo in _photos.OrderBy(x => x.Order))
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between">
                        <span class="d-flex align-items-center gap-2">
                            <span class="photo-hover">
                                <input type="checkbox" id="@($"photo-toggle-{photo.Id}")" class="photo-hover-toggle" />
                                <label for="@($"photo-toggle-{photo.Id}")" class="photo-hover-thumb-label">
                                    <img src="@GetThumbnailUrl(photo.Id)" alt="@photo.FileName" class="measurement-photo-thumbnail" />
                                </label>
                                <label for="@($"photo-toggle-{photo.Id}")" class="photo-hover-backdrop"></label>
                                <img src="@GetPhotoUrl(photo.Id)" alt="@photo.FileName" class="photo-hover-full" />
                            </span>
                            <span>@photo.FileName</span>
                        </span>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeletePhotoAsync(photo.Id)">Удалить</button>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    private const long MaxPhotoSizeBytes = 15 * 1024 * 1024;
    private string? _measurementId;
    private string? _error;
    private string? _message;
    private bool _isScanning;
    private ICollection<MeasurementPhotoResponse> _photos = [];

    [Parameter]
    public string? MeasurementId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(MeasurementId))
        {
            return;
        }

        _measurementId = MeasurementId;
        await LoadPhotosAsync();
    }

    private async Task ScanBarcodeAsync()
    {
        _isScanning = true;
        _error = null;
        _message = null;

        try
        {
            var scannedValue = await Interop.StartQrScanner();
            _measurementId = ExtractMeasurementId(scannedValue);

            if (string.IsNullOrWhiteSpace(_measurementId))
            {
                _error = "Не удалось распознать идентификатор измерения в штрихкоде.";
                _photos = [];
                return;
            }

            await LoadPhotosAsync();
            _message = $"Штрихкод распознан: {_measurementId}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to scan barcode for measurement photos page");
            _error = "Ошибка при сканировании штрихкода.";
        }
        finally
        {
            _isScanning = false;
        }
    }

    private async Task OnPhotosSelectedAsync(InputFileChangeEventArgs eventArgs)
    {
        if (string.IsNullOrWhiteSpace(_measurementId))
        {
            _error = "Сначала отсканируйте штрихкод.";
            return;
        }

        _error = null;
        _message = null;

        foreach (var file in eventArgs.GetMultipleFiles())
        {
            await using var stream = file.OpenReadStream(MaxPhotoSizeBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);

            await WebApiClient.UploadMeasurementPhotoAsync(
                _measurementId,
                new MeasurementPhotoUploadRequest
                {
                    FileName = file.Name,
                    ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                    File = memory.ToArray()
                });
        }

        await LoadPhotosAsync();
        _message = "Фотографии загружены.";
    }

    private async Task DeletePhotoAsync(Guid photoId)
    {
        if (string.IsNullOrWhiteSpace(_measurementId))
        {
            return;
        }

        _error = null;
        _message = null;

        try
        {
            await WebApiClient.DeleteMeasurementPhotoAsync(_measurementId, photoId);
            await LoadPhotosAsync();
            _message = "Фотография удалена.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete photo {PhotoId} for measurement {MeasurementId}", photoId, _measurementId);
            _error = "Не удалось удалить фотографию.";
        }
    }

    private async Task LoadPhotosAsync()
    {
        if (string.IsNullOrWhiteSpace(_measurementId))
        {
            _photos = [];
            return;
        }

        _photos = await WebApiClient.GetMeasurementPhotosAsync(_measurementId);
    }

    private string GetPhotoUrl(Guid photoId)
    {
        return $"{WebApiClient.BaseUrl}measurements/{_measurementId}/photos/{photoId}/content";
    }

    private string GetThumbnailUrl(Guid photoId)
    {
        return $"{WebApiClient.BaseUrl}measurements/{_measurementId}/photos/{photoId}/thumbnail/content";
    }

    private static string ExtractMeasurementId(string scannedValue)
    {
        var value = (scannedValue ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        if (Uri.TryCreate(value, UriKind.Absolute, out var uri))
        {
            return uri.Segments.Last().Trim('/').Trim();
        }

        if (value.Contains('/'))
        {
            return value.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).LastOrDefault() ?? string.Empty;
        }

        return value;
    }
}
