@page "/"
@using System.Text.RegularExpressions
@using Client.Clients.Generated
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject EbayClient EbayClient

<PageTitle>Перечень товаров</PageTitle>
<FallingFlowers />
<div style="display: flex; align-items: center; gap: 10px;">
    <h2>Перечень товаров</h2>
    <button class="btn btn-primary btn-sm" @onclick="UpdateAllPrices">Пересчитать цены</button>
</div>
<style>
    #productTable th {
      position: sticky;
      top: 3.5rem;
      background-color: white;
      z-index: 100;
      cursor: pointer;
    }
    
    #productTable td {
      vertical-align: middle;
    }
    
    .sort-icon {
      margin-left: 5px;
    }
</style>


<table id="productTable" class="table">
    <thead>
    <tr>
        <th @onclick="@(() => SortTable(nameof(ProductWithId.IsCheckRequired)))"><span class="sort-icon">@GetSortIcon(nameof(ProductWithId.IsCheckRequired))</span></th>
        <th @onclick="@(() => SortTable(nameof(ProductWithId.Name)))">
            Название
            <button class="btn btn-primary btn-sm" @onclick:stopPropagation="true" @onclick="StartCreateProduct">Добавить</button>
            <span class="sort-icon">@GetSortIcon(nameof(ProductWithId.Name))</span>
        </th>
        <th>
            Другие названия
        </th>
        <th>
            Запрос (eBay)
        </th>
        <th @onclick="@(() => SortTable(nameof(ProductWithId.Weight)))">
            Вес без упаковки
            <span class="sort-icon">@GetSortIcon(nameof(ProductWithId.Weight))</span>
        </th>
        <th @onclick="@(() => SortTable(nameof(ProductWithId.ProductCalculationResult.QuantityTotal)))">
            Шт. продано
            <span class="sort-icon">@GetSortIcon(nameof(ProductWithId.ProductCalculationResult.QuantityTotal))</span>
        </th>
        <th @onclick="@(() => SortTable("RevenueAvgTarget"))">
            Средняя выручка (@WellKnown.Currencies.TargetCurrency)
            <span class="sort-icon">@GetSortIcon("RevenueAvgTarget")</span>
        </th>
        <th>
            Дата расчета
        </th>
    </tr>
    </thead>

    <tbody>
    @foreach (var product in SortedProducts)
    {
        <tr>
            <td>
                @if (product.IsCheckRequired)
                {
                    <button class="btn btn-warning btn-sm oi oi-check" @onclick="@(e => MarkAsChecked(product))"></button>
                }
            </td>
            <td>
                <NavLink href="@($"Product/{product.Id}")" target="_blank">@Helpers.HighlightMinorityLetters(product.Name, "red")</NavLink>
            </td>
            <td>
                @foreach (var query in product.RuSearchQueries)
                {
                    <span>@Helpers.HighlightMinorityLetters(query.Query, "red")&#160;</span>
                }
            </td>
            <td>
                @foreach (var query in product.SearchQueries)
                {
                    <span><a href="@Helpers.GetSearchLink(query: query.Query, productId: product.Id)" rel="noreferrer" target=”_blank”>@Helpers.HighlightMinorityLetters(query.Query, "red")</a>&#160;</span>
                }
            </td>
            @if (product.Weight == 0)
            {
                <td class="text-danger">Не задан</td>
            }
            else
            {
                <td>@product.Weight</td>
            }
            @if (product.ProductCalculationResult?.QuantityTotal > 0)
            {
                <td>@product.ProductCalculationResult?.QuantityTotal</td>
                <td>@((product.ProductCalculationResult?.RevenueAvg * _targetCurrencyRate)?.ToString("N0"))</td>
                <td>@product.ProductCalculationResult?.CalculationDate</td>
            }
            else
            {
                <td></td>
                <td></td>
                <td></td>
            }
        </tr>
    }
    </tbody>
</table>

@if (_showProductModal)
{
    <div class="modal fade show" tabindex="-1" role="dialog" style="display: block;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_productProperties?.WindowHeader)</h5>
                </div>
                <div class="modal-body">
                    <ProductProperties @ref="_productProperties" OnSuccess="OnProductSaved" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelProduct" data-dismiss="modal">Отмена</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<QuestionPopup @ref="_questionPopup"/>

@code {
    private ProductProperties _productProperties = null!;
    private bool _showProductModal;
    private QuestionPopup _questionPopup = null!;
    private double _targetCurrencyRate;

    private ICollection<ProductWithId> _products = new List<ProductWithId>();
    private IEnumerable<ProductWithId> SortedProducts => ApplySorting(_products);

    private string _sortColumn = string.Empty;
    private bool _sortAscending = true;

    protected async override Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadActualProductList(), GetCurrencies());
    }

    private async Task GetCurrencies()
    {
        var currencies = await EbayClient.GetCurrenciesAsync();
        var dict = currencies.ToDictionary(keySelector: x => x.EbayName, elementSelector: x => x.Rate);
        _targetCurrencyRate = dict[WellKnown.Currencies.TargetCurrency];
    }

    private void UpdateAllPrices()
    {
        _questionPopup.AskQuestion(questionText: "Пересчитать цены для всех?", async () => { await EbayClient.CalculatePricesForAllAsync(CancellationToken.None); });
    }

    private async Task LoadActualProductList()
    {
        _products = await EbayClient.GetAllProductsAsync();
        StateHasChanged();
    }

    private void SortTable(string columnName)
    {
        if (_sortColumn == columnName)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = columnName;
            _sortAscending = true;
        }

        StateHasChanged();
    }

    private string GetSortIcon(string columnName)
    {
        if (_sortColumn != columnName)
            return "";

        return _sortAscending ? "↑" : "↓";
    }

    private IEnumerable<ProductWithId> ApplySorting(IEnumerable<ProductWithId> products)
    {
        if (string.IsNullOrEmpty(_sortColumn))
            return products;

        var result = products.ToList();

        switch (_sortColumn)
        {
            case nameof(ProductWithId.Name):
                result = _sortAscending
                    ? result.OrderBy(p => p.Name).ToList()
                    : result.OrderByDescending(p => p.Name).ToList();
                break;
                
            case nameof(ProductWithId.IsCheckRequired):
                result = _sortAscending
                    ? result.OrderBy(p => p.IsCheckRequired).ToList()
                    : result.OrderByDescending(p => p.IsCheckRequired).ToList();
                break;

            case nameof(ProductWithId.Weight):
                result = _sortAscending
                    ? result.OrderBy(p => p.Weight).ToList()
                    : result.OrderByDescending(p => p.Weight).ToList();
                break;

            case nameof(ProductWithId.ProductCalculationResult.QuantityTotal):
                result = _sortAscending
                    ? result.OrderBy(p => p.ProductCalculationResult?.QuantityTotal ?? 0).ToList()
                    : result.OrderByDescending(p => p.ProductCalculationResult?.QuantityTotal ?? 0).ToList();
                break;
                
            case "RevenueAvgTarget":
                result = _sortAscending
                    ? result.OrderBy(p => (p.ProductCalculationResult?.RevenueAvg ?? 0) * _targetCurrencyRate).ToList()
                    : result.OrderByDescending(p => (p.ProductCalculationResult?.RevenueAvg ?? 0) * _targetCurrencyRate).ToList();
                break;

            default: throw new InvalidOperationException(_sortColumn);
        }

        return result;
    }

    private void MarkAsChecked(ProductWithId product)
    {
        _questionPopup.AskQuestion(
            questionText: $"Вы действительно хотите отметить товар '{product.Name}' как учтенный?",
            async () =>
            {
                await EbayClient.MarkProductAsCheckedAsync(product.Id);
                await LoadActualProductList();
            });
    }

    private async Task StartCreateProduct()
    {
        _showProductModal = true;
        await Task.Yield();
        _productProperties.StartCreate();
    }

    private Task OnProductSaved()
    {
        _showProductModal = false;
        return LoadActualProductList();
    }

    private void CancelProduct()
    {
        _productProperties.Reset();
        _showProductModal = false;
    }
}
