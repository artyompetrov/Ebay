@page "/m/{measurementId}"
@model Server.Pages.MeasurementPage

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <title>Test results of @Model.Measurement.Product.SearchQueries.FirstOrDefault()?.Query #@Model.Measurement.Id</title>
</head>
<style>
    .my-table {
        border-collapse: collapse;
        width: 100%;
    }
    .my-table th, .my-table td {
        border: 1px solid #999;
        padding: 6px 10px;
        text-align: left;
    }
    .my-table th {
        background: #f5f5f5;
    }
    
    img {
        display: block;
        width: auto;
        height: auto;
        margin: auto;
    }
    
    pre {
        font-size: 14px; white-space: pre-wrap; word-break: break-word; overflow-x: auto;
    }
</style>

<body>
<table class="my-table">
    <tr>
        <td style="text-align: center; background-color: #ececec">
            <h4>Thank you for your purchase!</h4>
            <p>
                If you’re happy with your order, please consider leaving positive feedback - it really helps my small business.<br>
                If you need more items, you can find them in my <a href="https://www.ebay.com/usr/radiotubes_kz" rel="noreferrer" target="_blank">radiotubes_kz</a> eBay store.<br>
            </p>
        </td>
    </tr>
    <tr>
        <td>
            <h2 style="text-align: center">Tube @Model.Measurement.Product.SearchQueries.FirstOrDefault()?.Query #@Model.Measurement.Id</h2>
            <p><b>Manufacture date:</b> @Model.Measurement.ManufactureDate</p>
            <p><b>Condition:</b> @Model.Measurement.ProductState</p>
            <p><b>Measurement equipment:</b> <a href="https://www.dos4ever.com/uTracer3/uTracer3_pag0.html" rel="noreferrer" target="_blank">uTracer 3+</a> tube tester.</p>
            <p><b>Measurement ranges:</b> Anode and screen supplies: 0 to 400 V @@ 600 mA. Negative grid supply: 0 to -50 V</p>
            <p><b>Download:</b> <a href="/m/@Model.Measurement.Id/download" target="_blank">Zip archive</a> with measurement results.
                You can import it into <a href="https://www.dos4ever.com/uTracer3/uTracer3_pag5.html#importexcel" rel="noreferrer" target="_blank">Excel</a>,
                or a <a href="https://www.dos4ever.com/uTracer3/uTracer3_pag16.html" rel="noreferrer" target="_blank">load line tool</a> (load line tool works with anode_curves.utd file).
        </td>
    </tr>
    <tr>
        <td>
            <h2 style="text-align: center">Quick test results:</h2>
            <br/>
            <pre>@Model.QuickTest</pre>
        </td>
    </tr>
    <tr>
        <td>
            <h2 style="text-align: center">Curves:</h2>
            <img src="/m/@Model.Measurement.Id/curves?height=600&width=1200" alt="Curves">
        </td>
    </tr>
</table>
</body>
</html>