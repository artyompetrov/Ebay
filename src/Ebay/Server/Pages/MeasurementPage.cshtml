@page "/m/{measurementId}"
@model Server.Pages.MeasurementPage

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    @if (Model.Measurement == null)
    {
        <title>Measurement not found</title>
    }
    else
    {
        <title>@Model.Measurement.Id</title>
    }
</head>
<body>
<div>
    @if (Model.Measurement == null)
    {
        <h1>Measurement not found</h1>
    }
    else
    {
        <h1>@Model.Measurement.Product.RuSearchQueries.FirstOrDefault()?.Query</h1>
        <h4>ManufactureDate: @Model.Measurement.ManufactureDate</h4>
        <h4>State: @Model.Measurement.ProductState</h4>
        
        <img src="/m/@Model.Measurement.Id/anode_curves" alt="Anode curves">
    }
</div>
</body>
</html>