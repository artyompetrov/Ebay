{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentityServer": {
    "Clients": {
      "Ebay.Client": {
        "Profile": "IdentityServerSPA"
      },
      "Ebay.ChromeExtension": {
        "Profile": "SPA",
        "RedirectUri": "https://www.ebay.com/",
        "LogoutUri": "https://www.ebay.com/logout"
      },
      "Ebay.Odoo": {
        "Profile": "SPA",
        "RedirectUri": "https://localhost/web/login",
        "LogoutUri": "https://localhost/web/login"
      }
    }
  },
  "AllowedHosts": "*"
}
