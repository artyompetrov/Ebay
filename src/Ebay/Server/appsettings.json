{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentityServer": {
    "Clients": {
      "Frontend": {
        "Profile": "IdentityServerSPA"
      }
    }
  },
  "AllowedHosts": "*",
  "AuthorizationClient": {
    "DataProtectionKeysDirectory": "/tmp/data_protection_keys_dir",
    "Domain": "localhost",
    "ClientId": "client_id",
    "Scope": "scope",
    "ClientSecret": "secret"
  }
}
