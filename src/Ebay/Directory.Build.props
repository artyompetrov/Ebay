<Project>
    <Import Project="Directory.Build.Global.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <WarningsNotAsErrors>
            $(WarningsNotAsErrors),
        </WarningsNotAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
        <!-- Service-local bans (singleton-only DI, DbContext factories, typed HttpClients); the file above is mirrored. -->
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)../BannedSymbols.txt" />
    </ItemGroup>
</Project>