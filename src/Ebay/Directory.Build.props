<Project>
    <Import Project="Directory.Build.Global.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <WarningsNotAsErrors>
            $(WarningsNotAsErrors),
        </WarningsNotAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    </ItemGroup>
    <!-- EBAY0001 (Analyzers/NoThrowAnalyzer): production code returns expected failures as OneOf results and panics
         on bugs only with UnreachableException / ArgumentNullException.ThrowIfNull / ArgumentOutOfRangeException.ThrowIf*.
         Test projects may throw (fakes simulate failing dependencies, assertions fail tests). -->
    <ItemGroup Condition="'$(MSBuildProjectName)' != 'Analyzers' and !$(MSBuildProjectName.StartsWith('Tests.'))">
        <ProjectReference Include="$(MSBuildThisFileDirectory)Analyzers/Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>
</Project>