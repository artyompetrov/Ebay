<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Архитектурное правило (ports-and-adapters):
      - application-слой должен зависеть от доменного слоя (Server.Domain);
      - зависимости на внешние библиотеки допустимы только в порядке исключения,
        когда без них невозможно реализовать слой приложения.
    -->
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Server.Application.Abstractions.Driven\Server.Application.Abstractions.Driven.csproj" />
        <ProjectReference Include="..\Server.Application.Abstractions.Driving\Server.Application.Abstractions.Driving.csproj" />
        <ProjectReference Include="..\Server.Domain\Server.Domain.csproj" />
    </ItemGroup>

</Project>
