@page "/purchase"
@model Server.Application.Pages.PurchasePage

@{
    Layout = null;
    var baseUrl = $"{Request.Scheme}://{Request.Host}";
}

<style>
    table {
        margin: 0 auto;
        border-collapse: collapse;
    }

    th, td {
        border: 1px solid #ccc;
        padding: 8px;
        text-align: center;
    }

    th {
        background-color: #f5f5f5;
    }
</style>

<table>
    <tr>
        <th>Tube #</th>
        <th>Curves</th>
    </tr>
    @foreach (var measurement in Model.Measurements)
    {
        <tr>
            <td>
                #@measurement.Id
                <br /><br />
                @measurement.ManufactureCode
                <br /><br />
                @measurement.ProductState
            </td>
            <td>
                <img src="@($"{baseUrl}/m/{measurement.Id}/ebay_curves")" alt="@measurement.Id" />
            </td>
        </tr>
    }
</table>
