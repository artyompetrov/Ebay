@page "/ebay_description/{productId}"
@using System.Net
@using Server.Application.Pages
@using Server.Domain.Measurements
@model Server.Application.Pages.EbayLotDescriptionPage

@{
    Layout = null;
    var baseUrl = $"{Request.Scheme}://{Request.Host}";

    static string GetName(EbayLotDescriptionPage model)
    {
        var name = model.Product.SearchQueries.First().Query;

        if (model.State == ProductState.New)
        {
            name += ", NEW";
        }

        if (model.Measurements.Any())
        {
            name += ", uTracer3+";
            if (model.Measurements.Any(x => x.MatchId != null))
            {
                name += " MATCHED";
            }
            else
            {
                name += " TESTED";
            }
        }

        return name;
    }
}

<h2 style="text-align: center; ">@GetName(Model)</h2>

<img src="@($"{baseUrl}/empty_picture?product={WebUtility.UrlEncode(GetName(Model))}&lotId={WebUtility.UrlDecode(Model.LotId)}")" alt="" style="height: 1px; width: 1px;" />

<h3>📦 Shipping & Handling:</h3>
<p><strong>Combined shipping</strong> is available — order multiple items to save on shipping costs!</p>
<p>When you order more than one item with paid shipping (even from different listings in our store), you <strong>save on shipping</strong> because the cost for additional items is <strong>significantly lower</strong>.</p>
<p>🛒 Check out our other listings at <a href="https://www.ebay.com/sch/i.html?_ssn=radiotubes_kz" target="_blank">our radiotubes_kz eBay store</a>.</p>

<p>Shipping from <strong>Kazakhstan</strong></p>
<p>Worldwide shipping available via <strong>KazPost</strong></p>
<p>Secure packaging with anti-shock materials to prevent damage</p>
<p>Tracking number provided within <strong>3–5 business days</strong></p>

<h3>🕐 Estimated delivery time:</h3>
<p>Approximate delivery time — <strong>25 to 35 days</strong>, depending on the destination.</p>

@if (Model.Measurements.Count > 0)
{
    <br/>
    <h2 style="text-align: center;">📈 Tested Vacuum Tube — Measurement Results Below</h2>
    <p>This vacuum tube has been professionally tested using a <strong>uTracer 3+</strong> tube tester — a trusted tool among audiophiles and engineers.</p>
    
    <h3>📐 High-Quality Vector Graphs (SVG)</h3>
    <p>Each tested tube comes in a labeled box with a barcode sticker. By scanning the barcode, you can access the detailed test results for that specific tube.</p>
    <p>The test graphs are provided in <strong>SVG vector format</strong>. You can right-click on any graph and open it in a new tab to zoom in without losing clarity.</p>
    
    <h3>🔍 Choosing a Specific Tube</h3>
   
    <p>If you're purchasing from a batch of tested tubes:</p>
    <p><strong>After purchase, please message me with the number of the tube you want</strong> (each graph is labeled).</p>
    <p>If no number is provided within 24 hours, a tube will be selected and shipped randomly.</p>
    <br/>

    <style>
        table {
            margin: 0 auto;
            border-collapse: collapse;
        }
    
        th, td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: center;
        }

        .tube-col {
            max-width: 130px;
            word-wrap: break-word;
            overflow-wrap: break-word;
            word-break: break-all;
        }

        .nowrap {
            white-space: nowrap;
            font-weight: bold;
        }
        .balanced {
            color: green;
        }
    
        th {
            background-color: #f5f5f5;
        }
        
        .match-group-even td {
            background-color: #ffffff;
        }

        .match-group-odd td {
            background-color: #f0f8ff;
        }
    </style>
    
    <table >

        @{ var matchIndex = 1; }
        
        @{
            var groupedCollection =  Model.Measurements.GroupBy(x => x.MatchId)
                .Select(x=> (
                    MatchKey: x.Key,
                    SumBalance: (x.Key == null ? double.PositiveInfinity : /*matched всегда выше не matched*/
                        x.Select(x=>x.DoubleTriodeSectionRmse ?? 100.0 /*без замеров показыаются ниже чем с замерами*/)
                        .Sum()),
                    Items: x.ToList())
                )
                .OrderBy(x=>x.SumBalance).ToList();

            var hasMatchedPairs = groupedCollection.Any(x => x.MatchKey != null);
        }
        
        
        <tr>
            @if (hasMatchedPairs)
            {
                <th>Match#</th>
            }
            <th>Tube#</th>
            <th>Curves</th>
        </tr>
        
        <tr class="match-group-odd">
            <td rowspan="2">
                <text>Match #@matchIndex</text>
            </td>
            <td class="tube-col">
                Tube #@Model.FakeTubeId1
            </td>
            <td>
                <img src="@($"{baseUrl}/m/sold")" alt=""/>
            </td>
        </tr>
        <tr class="match-group-odd">
            <td class="tube-col">
                Tube #@Model.FakeTubeId2
            </td>
            <td>
                <img src="@($"{baseUrl}/m/sold")" alt=""/>
            </td>
        </tr>
        
        @foreach (var grouping in groupedCollection)
        {
            matchIndex++;
           
            var rowClass = matchIndex % 2 == 0 ? "match-group-even" : "match-group-odd";

            for (var i = 0; i < grouping.Items.Count; i++)
            {
                var doubleTriodeSectionRmse = grouping.Items.Max(x => x.DoubleTriodeSectionRmse);
                
                var meas = grouping.Items[i];
                <tr class="@rowClass">
                @if (hasMatchedPairs)
                {
                    @* только в первой строке группы рисуем объединённую ячейку *@
                    @if (i == 0)
                    {
                        <td rowspan="@grouping.Items.Count">
                            @if (grouping.MatchKey != null)
                            {
                                <text>Match #@matchIndex</text>
                            }
                            else
                            {
                                <text>Not</text>
                                <br/>
                                <text>matched</text>
                            }
                        </td>
                    }
                }

                <td class="tube-col">
                        Tube #@meas.Id
                        <br/><br/>
                        @meas.ManufactureCode
                        <br/><br/>
                        @meas.ProductState
                        <br/><br/>
                        @if (doubleTriodeSectionRmse != null)
                        {
                            @if (doubleTriodeSectionRmse < 5)
                            {
                                <span class="balanced">
                                    <span class="nowrap">EXCELLENT</span>
                                    <span class="nowrap">SECTION</span>
                                    <span class="nowrap">BALANCE!</span>
                                    <span class="nowrap">(less than 5%)</span>
                                </span>
                            }
                            else if (doubleTriodeSectionRmse < 10)
                            {
                                <span class="balanced">
                                    <span class="nowrap">EXCELLENT</span>
                                    <span class="nowrap">SECTION</span>
                                    <span class="nowrap">BALANCE!</span>
                                    <span class="nowrap">(less than 10%)</span>
                                </span>
                            }
                            else if (doubleTriodeSectionRmse < 20)
                            {
                                <span class="balanced">
                                    <span class="nowrap">GOOD</span>
                                    <span class="nowrap">SECTION</span>
                                    <span class="nowrap">BALANCE!</span>
                                    <span class="nowrap">(less than 20%)</span>
                                </span>
                            }
                            else if (doubleTriodeSectionRmse < 30)
                            {
                                <span class="nowrap">FAIR</span>
                                <span class="nowrap">SECTION</span>
                                <span class="nowrap">BALANCE!</span>
                                <span class="nowrap">(less than 30%)</span>
                            }
                        }
                    </td>
                    <td>
                        @{
                            var lotIdPart = meas.LotId == null ? "" : $"?lotId={WebUtility.UrlDecode(meas.LotId)}";
                        }
                        <img src="@($"{baseUrl}/m/{meas.Id}/ebay_curves{lotIdPart}")"
                             alt="@meas.Id"/>
                    </td>
                </tr>
            }
        }
    </table>
}

@if (Model.Passports.Count > 0)
{
    <p>You can view the passport scans by expanding the section below.</p>
    <input type="checkbox" id="passport-toggle" class="passport-toggle" />
    <label for="passport-toggle" class="passport-label">📄 Product passport (click to expand)</label>
    <div class="passport-content">
        @foreach (var passport in Model.Passports)
        {
            <img src="@($"{baseUrl}/products/{Model.ProductId}/passports/{passport.Id}")" alt="@passport.FileName" />
        }
    </div>
    <style>
        .passport-toggle { display: none; }
        .passport-label { cursor: pointer; color: #0063d1; text-decoration: underline; }
        .passport-toggle:not(:checked) + .passport-label + .passport-content { display: none; }
        .passport-content img { max-width: 100%; height: auto; display: block; margin: 10px auto; }
    </style>
}