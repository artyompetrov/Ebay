@page "/ebay_description/{productId}"
@using System.Net
@using Server.Application.Data.Models
@using Server.Application.Data.Models.Measurements
@using Server.Application.Pages
@model Server.Application.Pages.EbayLotDescriptionPage

@{
    Layout = null;
    var baseUrl = $"{Request.Scheme}://{Request.Host}";

    static string GetName(EbayLotDescriptionPage model)
    {
        var name = model.Product.SearchQueries.First();

        if (model.State == ProductState.New)
        {
            name += ", NEW";
        }

        if (model.Product.Measurements.Count > 0)
        {
            name += ", uTracer3+ TESTED";
        }

        return name;
    }
}

<h2 style="text-align: center; ">@GetName(Model)</h2>

<h3>📦 Shipping & Handling:</h3>
<p>Origin: Shipped from <strong>Kazakhstan</strong></p>
<p>Worldwide shipping available via <strong>KazPost</strong></p>
<p>Secure packaging with anti-shock materials to prevent damage</p>
<p>Tracking number provided within <strong>3–5 business days</strong></p>

<h3>🕐 Estimated delivery time:</h3>
<p>Approximate delivery time — <strong>25 to 35 days</strong>, depending on the destination.</p>

<h3>Thank you for choosing us! Check out our other lots.</h3>

@if (Model.Product.Measurements.Count > 0)
{
    <br/>
    <h2 style="text-align: center;">📈 Tested Vacuum Tube — Measurement Results Below</h2>
    <p>This vacuum tube has been professionally tested using a <strong>uTracer 3+</strong> tube tester — a trusted tool among audiophiles and engineers.</p>
    <p>Each tested tube comes in a labeled box with a barcode sticker. By scanning the barcode, you can access the detailed test results for that specific tube.</p>
    
    <h3>📐 High-Quality Vector Graphs (SVG)</h3>
    <p>The test graphs are provided in <strong>SVG vector format</strong>. You can right-click on any graph and open it in a new tab to zoom in without losing clarity.</p>
    
    <h3>🔍 Choosing a Specific Tube</h3>
   
    <p>If you're purchasing from a batch of tested tubes:</p>
    <p><strong>After purchase, please message me with the number of the tube you want</strong> (each graph is labeled).</p>
    <p>If no number is provided within 24 hours, a tube will be selected and shipped randomly.</p>
    <br/>

    <p><strong>Колонка «Похожие»</strong> показывает идентификаторы ближайших по параметрам ламп, а число рядом с ID — значение RMSE первой секции (чем меньше, тем точнее совпадение).</p>

    <style>
        table {
            margin: 0 auto;
            border-collapse: collapse;
        }
    
    
        th, td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: center;
        }
    
        th {
            background-color: #f5f5f5;
        }
    </style>
    
    <table >
        <tr>
            <th>Tube #</th>
            <th>Похожие и график</th>
        </tr>
        @foreach (var meas in Model.Product.Measurements)
        {
            <tr>
                <td>
                    #@meas.MeasurementId
                    <br/><br/>
                    @meas.ManufactureCode
                    <br/><br/>
                    @meas.ProductState
                </td>
                <td>
                    <img src="@($"{baseUrl}/m/{meas.MeasurementId}/similar_measurements")" alt="Похожие замеры для #@meas.MeasurementId" style="display: block; margin: 0 auto 12px; max-width: 100%; height: auto;" />
                    <img src="@($"{baseUrl}/m/{meas.MeasurementId}/ebay_curves?product={WebUtility.UrlEncode(GetName(Model))}")" alt="@meas.MeasurementId"/>
                </td>
            </tr>
        }
    </table>
}

@if (Model.Product.Passports.Count > 0)
{
    <p>You can view the passport scans by expanding the section below.</p>
    <input type="checkbox" id="passport-toggle" class="passport-toggle" />
    <label for="passport-toggle" class="passport-label">📄 Product passport (click to expand)</label>
    <div class="passport-content">
        @foreach (var passport in Model.Product.Passports)
        {
            <img src="@($"{baseUrl}/products/{Model.ProductId}/passports/{passport.Id}")" alt="@passport.FileName" />
        }
    </div>
    <style>
        .passport-toggle { display: none; }
        .passport-label { cursor: pointer; color: #0063d1; text-decoration: underline; }
        .passport-toggle:not(:checked) + .passport-label + .passport-content { display: none; }
        .passport-content img { max-width: 100%; height: auto; display: block; margin: 10px auto; }
    </style>
}
