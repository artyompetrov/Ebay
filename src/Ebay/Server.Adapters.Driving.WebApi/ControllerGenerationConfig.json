{
  "runtime": "Net100",
  "defaultVariables": null,
  "documentGenerator": {
    "fromDocument": {
      "url": "../Server.Contracts/WebApi/WebApi.yaml"
    }
  },
  "codeGenerators": {
    "openApiToCSharpController": {
      "namespace": "Server.Adapters.Driving.WebApi.Generated",
      "className": "WebApi",
      "output": "obj/Generated/Controllers/WebApiController.cs",
      "controllerBaseClass": "Microsoft.AspNetCore.Mvc.Controller",
      "controllerStyle": "Abstract",
      "useCancellationToken": true,
      "useActionResultType": true,
      "generateOptionalPropertiesAsNullable": true,
      "generateNullableReferenceTypes": true,
      "classStyle": "Record",
      "newLineBehavior": "LF",
      "jsonLibrary": "SystemTextJson",
      "requiredPropertiesMustBeDefined": false
    }
  }
}
