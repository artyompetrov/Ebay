@page "/ebay_description/{productId}"
@using System.Net
@using Server.Adapters.Driving.WebApi.Pages
@using Server.Domain.Measurements
@model Server.Adapters.Driving.WebApi.Pages.EbayLotDescriptionPage
<!-- @Model.LotId -->
@{
    Layout = null;
    var baseUrl = $"{Request.Scheme}://{Request.Host}";

    static string GetName(EbayLotDescriptionPage model)
    {
        var name = model.Product.SearchQueries.First().Query;

        if (model.State == ProductState.New)
        {
            name += ", NEW";
        }

        if (model.Measurements.Any())
        {
            name += ", uTracer3+";
            if (model.Measurements.Any(x => x.MeasurementInfo.MatchId != null))
            {
                name += " MATCHED";
            }
            else
            {
                name += " TESTED";
            }
        }

        return name;
    }
}
@if (Model.Measurements.Count > 0)
{
    <h2 style="text-align: center; ">@GetName(Model), See measurement results in table below 📈</h2>
}
else
{
    <h2 style="text-align: center; ">@GetName(Model)</h2>
}

@if (Model.Measurements.Count > 0)
{
    <h3>📐 High-Quality Vector Graphs (SVG)</h3>
    <p>This vacuum tube has been professionally tested using a <strong>uTracer 3+</strong> tube tester — a trusted tool among audiophiles and engineers.</p>
    <p>The test graphs are provided in <strong>SVG vector format</strong>. You can right-click on any graph and open it in a new tab to zoom in without losing clarity.</p>

    <h3>🔍 Choosing a Specific Tube</h3>
    <p>If you're purchasing from a batch of tested tubes:</p>
    <p><strong>After purchase, please message me with the number of the tube you want</strong> (each graph is labeled).</p>
    <p>If no number is provided within 24 hours, a tube will be selected and shipped randomly.</p>
}

<img src="@($"{baseUrl}/empty_picture?product={WebUtility.UrlEncode(GetName(Model))}&lotId={WebUtility.UrlDecode(Model.LotId)}")" alt="" style="height: 1px; width: 1px;" />

<h3>📦 Shipping & Handling:</h3>
<b>WE SHIP TO THE UNITED STATES — UNITED STATES TARIFFS ARE PAID BY OUR STORE BEFORE SHIPPING.</b>
<p><strong>Combined shipping</strong> is available — order multiple items to save on shipping costs!</p>
<p>When you order more than one item with paid shipping (even from different listings in our store), you <strong>save on shipping</strong> because the cost for additional items is <strong>significantly lower</strong>.</p>
<p>🛒 Check out our other listings at <a href="https://www.ebay.com/sch/i.html?_ssn=radiotubes_kz" target="_blank">our radiotubes_kz eBay store</a>.</p>

<p>Shipping from <strong>Kazakhstan</strong></p>
<p>Worldwide shipping available via <strong>KazPost</strong></p>
<p>Secure packaging with anti-shock materials to prevent damage</p>
<p>Tracking number provided within <strong>3–5 business days</strong></p>

<h3>🕐 Estimated delivery time:</h3>
<p>Approximate delivery time — <strong>25 to 35 days</strong>, depending on the destination.</p>

@if (Model.Measurements.Count > 0)
{
    <br/>
<style>
        table {
            margin: 0 auto;
            border-collapse: collapse;
        }
    
        th, td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: center;
        }

        .tube-col {
            word-wrap: break-word;
            overflow-wrap: break-word;
            word-break: break-all;
        }

        .tube-number {
            text-align: left;
            padding: 10px;
        }

        .nowrap {
            white-space: nowrap;
            font-weight: bold;
        }
        .balanced {
            color: green;
        }
    
        th {
            background-color: #f5f5f5;
        }
        
        .match-group-even td {
            background-color: #ffffff;
        }

        .match-group-odd td {
            background-color: #f0f8ff;
        }

        .measurement-photos {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
            margin-top: 10px;
        }

        .measurement-photo-thumb {
            width: 100px;
            height: 100px;
            object-fit: cover;
        }

        .photo-hover {
            position: relative;
            display: inline-block;
        }

        .photo-hover-toggle {
            display: none;
        }

        .photo-hover-thumb-label {
            display: block;
            margin: 0;
            cursor: pointer;
        }

        .photo-hover-backdrop {
            display: none;
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 999;
        }

        .photo-hover-toggle:checked ~ .photo-hover-backdrop {
            display: block;
        }

        .photo-hover-full {
            display: block;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            max-width: 90vw;
            max-height: 90vh;
            width: auto;
            height: auto;
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
            z-index: 1000;
            border: 2px solid #ccc;
            background: #fff;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
        }

        .photo-hover:hover .photo-hover-full,
        .photo-hover-toggle:checked ~ .photo-hover-full {
            visibility: visible;
            opacity: 1;
        }
    </style>

    @if (Model.PhotosByMeasurementId.Count > 0)
    {
        <p style="text-align: center;">📷 Hover over (or tap, on mobile) a tube's photo thumbnail below to view it full-size.</p>
    }

    <table >

        @{
            var matchIndex = 1;
            var tubeIndex = 2;
        }
        
        @{
            var groupedCollection =  Model.Measurements.GroupBy(x => x.MeasurementInfo.MatchId)
                .Select(x=> (
                    MatchKey: x.Key,
                    SumBalance: (x.Key == null ? double.PositiveInfinity : /*matched всегда выше не matched*/
                        x.Select(x=>x.DoubleTriodeSectionRmse ?? 100.0 /*без замеров показыаются ниже чем с замерами*/)
                        .Sum()),
                    Items: x.ToList())
                )
                .OrderBy(x=>x.SumBalance).ToList();

            var hasMatchedPairs = groupedCollection.Any(x => x.MatchKey != null);
        }
        
        
        <tr>
            @if (hasMatchedPairs)
            {
                <th>Match#</th>
            }
            <th>Tube#</th>
            <th>Curves</th>
        </tr>
        
        <tr class="match-group-odd">
        @if (hasMatchedPairs)
        {
            <td rowspan="2">
                <text>Match #1</text>
            </td>
        }
        <td class="tube-col">
            <div class="tube-number">Tube #1</div>
            <img src="@($"{baseUrl}/m/sold")" alt=""/>
        </td>
            <td>
                <img src="@($"{baseUrl}/m/sold")" alt=""/>
            </td>
        </tr>
        <tr class="match-group-odd">
            <td class="tube-col">
                <div class="tube-number">Tube #2</div>
                <img src="@($"{baseUrl}/m/sold")" alt=""/>
            </td>
            <td>
                <img src="@($"{baseUrl}/m/sold")" alt=""/>
            </td>
        </tr>
        
        @foreach (var grouping in groupedCollection)
        {
        
            
            matchIndex++;
           
            var rowClass = matchIndex % 2 == 0 ? "match-group-even" : "match-group-odd";

            for (var i = 0; i < grouping.Items.Count; i++)
            {
                var meas = grouping.Items[i];
                <tr class="@rowClass">
                    @if (hasMatchedPairs)
                    {
                        @* только в первой строке группы рисуем объединённую ячейку *@
                        @if (i == 0)
                        {
                            <td rowspan="@grouping.Items.Count">
                                @if (grouping.MatchKey != null)
                                {
                                    <text>Match #@matchIndex</text>
                                }
                                else
                                {
                                    <text>Not</text>
                                    <br/>
                                    <text>matched</text>
                                }
                            </td>
                        }
                    }
                    @{
                        var lotIdPart = meas.MeasurementInfo.LotId == null ? "" : $"?lotId={WebUtility.UrlDecode(meas.MeasurementInfo.LotId)}";
                        tubeIndex++;
                    }
                    
                    
                    <td class="tube-col">
                        <div class="tube-number">Tube #@tubeIndex</div>
                        <img src="@($"{baseUrl}/m/{meas.MeasurementInfo.Id}/ebay_tube_description{lotIdPart}")"
                             alt="@meas.MeasurementInfo.Id"/>
                    </td>
                    <td>
                        <img src="@($"{baseUrl}/m/{meas.MeasurementInfo.Id}/ebay_curves{lotIdPart}")"
                             alt="@meas.MeasurementInfo.Id"/>
                        <div class="measurement-photos">
                            @foreach (var photo in Model.PhotosByMeasurementId[meas.MeasurementInfo.Id])
                            {
                                var photoToggleId = $"photo-toggle-{photo.Id}";
                                <span class="photo-hover">
                                    <input type="checkbox" id="@photoToggleId" class="photo-hover-toggle" />
                                    <label for="@photoToggleId" class="photo-hover-thumb-label">
                                        <img class="measurement-photo-thumb"
                                             src="@($"{baseUrl}/api/webapi/v1/measurements/{meas.MeasurementInfo.Id}/photos/{photo.Id}/thumbnail/content")"
                                             alt="@photo.FileName"/>
                                    </label>
                                    <label for="@photoToggleId" class="photo-hover-backdrop"></label>
                                    <img class="photo-hover-full"
                                         src="@($"{baseUrl}/api/webapi/v1/measurements/{meas.MeasurementInfo.Id}/photos/{photo.Id}/content")"
                                         alt="@photo.FileName"/>
                                </span>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
    </table>
}

@if (Model.Passports.Count > 0)
{
    <p>You can view the passport scans by expanding the section below.</p>
    <input type="checkbox" id="passport-toggle" class="passport-toggle" />
    <label for="passport-toggle" class="passport-label">📄 Product passport (click to expand)</label>
    <div class="passport-content">
        @foreach (var passport in Model.Passports)
        {
            <img src="@($"{baseUrl}/products/{Model.ProductId}/passports/{passport.Id}")" alt="@passport.FileName" />
        }
    </div>
    <style>
        .passport-toggle { display: none; }
        .passport-label { cursor: pointer; color: #0063d1; text-decoration: underline; }
        .passport-toggle:not(:checked) + .passport-label + .passport-content { display: none; }
        .passport-content img { max-width: 100%; height: auto; display: block; margin: 10px auto; }
    </style>
}
