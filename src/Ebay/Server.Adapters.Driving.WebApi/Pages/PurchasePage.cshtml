@page "/purchase"
@model Server.Adapters.Driving.WebApi.Pages.PurchasePage

@{
    Layout = null;
    var baseUrl = $"{Request.Scheme}://{Request.Host}";
}

<style>
    table {
        margin: 0 auto;
        border-collapse: collapse;
    }

    th, td {
        border: 1px solid #ccc;
        padding: 6px;
        text-align: center;
    }

    th {
        background-color: #f5f5f5;
    }

    .message {
        text-align: center;
        margin: 20px auto;
        font-family: Arial, sans-serif;
        max-width: 480px;
        font-size: 14px;
        line-height: 1.3;
    }

    /* --- Print settings --- */
    @@media print {
        @@page {
            size: A4 landscape; /* альбомная ориентация */
            margin: 6mm; /* меньше отступов */
        }

        body {
            -webkit-print-color-adjust: exact;
        }

        .message {
            margin: 10px auto;
            max-width: 400px;
            font-size: 12px;
            line-height: 1.2;
        }

        table {
            width: 100%;
            font-size: 11px;
        }

        td img {
            max-width: 95%;
            height: auto;
        }
    }
</style>


<div class="message">
    <h2>Thank you for your order!</h2>
    <p>
        We’d love to hear your thoughts! Your feedback means a lot to us and helps us improve our work.
    </p>
    <p>Have a nice day!</p>
</div>

<table>
    
    @{
        var matchIndex = 0;
        
        var groupedCollection =  Model.Measurements.GroupBy(x => x.MatchId)
            .OrderByDescending(x=>x.Key).ToList();

        var hasMatchedPairs = groupedCollection.Select(x => x.Key).Distinct().Any(x => x is not null);
    }
    
    
    
    
    <tr>
        @if (hasMatchedPairs)
        {
            <th>Match #</th>
        }
        <th>Tube #</th>
        <th>Curves</th>
    </tr>
    @foreach (var grouping in groupedCollection)
    {
        matchIndex += 1;
        foreach (var measurement in grouping)
        {
            <tr>
                @if (hasMatchedPairs)
                {
                    <td>
                        @if (grouping.Key is not null)
                        {
                            <text>Match @matchIndex</text>
                        }
                        else
                        {
                            <text>Not matched</text>
                        }
                    </td>
                }
                <td>
                    #@measurement.Id
                    <br/><br/>
                    @measurement.ManufactureCode
                    <br/><br/>
                    @measurement.ProductState
                </td>
                <td>
                    <img src="@($"{baseUrl}/m/{measurement.Id}/ebay_curves?sellingOnly=false")" alt="@measurement.Id"/>
                </td>
            </tr>
        }

    }
</table>
