<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.ApiAuthorization.IdentityServer" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="NSwag.MSBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Server.Application.New\Server.Application.New.csproj" />
    <ProjectReference Include="..\Server.Domain\Server.Domain.csproj" />
  </ItemGroup>

  <Target Name="GenerateControllers" BeforeTargets="CoreCompile">
    <Exec Command="$(NSwagExe_Net100) run ControllerGenerationConfig.json" />
  </Target>

  <Target Name="GenerateLegacyApiClients" BeforeTargets="CoreCompile">
    <Exec Command="$(NSwagExe_Net100) openapi2cscontroller /input:../Server.Contracts/Legacy/Ebay.yaml /classname:Ebay /namespace:Server.Controllers.Generated /output:$(BaseIntermediateOutputPath)Generated/Controllers/EbayController.cs /ControllerBaseClass:Microsoft.AspNetCore.Mvc.Controller /UseCancellationToken:true /GenerateImmutableArrayProperties:true /GenerateImmutableDictionaryProperties:true /GenerateNullableReferenceTypes:true /GenerateOptionalPropertiesAsNullable:true /ClassStyle:Record /ExcludedTypeNames:ProblemDetails,ValidationProblemDetails /RequiredPropertiesMustBeDefined:false" />
  </Target>

  <Target Name="IncludeGeneratedControllers" BeforeTargets="CoreCompile" DependsOnTargets="GenerateControllers;GenerateLegacyApiClients">
    <ItemGroup>
      <Compile Include="$(BaseIntermediateOutputPath)Generated/Controllers/**/*.cs" />
    </ItemGroup>
  </Target>

</Project>
