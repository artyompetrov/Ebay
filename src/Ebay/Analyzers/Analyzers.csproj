<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Project-own Roslyn analyzers. Directory.Build.props plugs this project into every production project
      as an analyzer (not as an assembly reference); test projects don't get it.
      Roslyn loads analyzers into the compiler, so the target is netstandard2.0 and the Roslyn package version
      must not be newer than the compiler of the oldest supported SDK.
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>

</Project>
