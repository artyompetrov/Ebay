@page "/LotSales/{ProductId:guid}"
@using Ebay.Client.Clients.Generated
@using Microsoft.AspNetCore.Authorization
@using Plotly.Blazor
@using Plotly.Blazor.Traces
@using System.Text
@using Plotly.Blazor.Interop
@using Plotly.Blazor.LayoutLib
@using Plotly.Blazor.LayoutLib.ShapeLib
@using Plotly.Blazor.Traces.ScatterLib
@using Ebay.Client.Extensions
@using Line = Plotly.Blazor.LayoutLib.ShapeLib.Line
@attribute [Authorize]
@inject EbayClient EbayClient
@inject ILogger<LotSales> Logger

<style>
    #lotSalesTable th {
      position: sticky;
      top: 3.5rem;
      background-color: white;
      z-index: 100;
    }
    
    #lotSalesTable td {
      vertical-align: middle;
    }
    
    a:focus {
        background-color: #dcdcdc;
    }
</style>

@if (_lots != null && _product != null)
{
    <PageTitle>Продажи товара @_product.Name</PageTitle>

    <h4>Статистика @_product.Name</h4>

    <EditForm EditContext="@_parametersModelEditContext"/>
    <div class="form-check form-check-inline">
        <InputCheckbox class="form-check-input" id="new" @bind-Value="@_parametersModel.New" @bind-Value:after="UpdatePage"/>
        <label class="form-check-label" for="new">Новые</label>
    </div>
    <div class="form-check form-check-inline">
        <InputCheckbox class="form-check-input" id="used" @bind-Value="@_parametersModel.Used" @bind-Value:after="UpdatePage"/>
        <label class="form-check-label" for="used">БУ</label>
    </div>
    <div class="form-check form-check-inline">
        <InputCheckbox class="form-check-input" id="subtractShippingCosts" @bind-Value="@_parametersModel.SubtractShippingCosts" @bind-Value:after="UpdatePage"/>
        <label class="form-check-label" for="subtractShippingCosts">Полный расчет стоимости доставки</label>
    </div>
    <div class="form-check form-check-inline">
        <InputCheckbox class="form-check-input" id="isRecent" @bind-Value="@_parametersModel.IsRecent" @bind-Value:after="UpdatePage"/>
        <label class="form-check-label" for="isRecent">Игнорировать продажи до изменения имени</label>
    </div>

    <br/>
    @if (_product.Weight == 0)
    {
        <h3 class="text-danger">Вес без упаковки не задан, для правильного расчета нужно задать вес <a href="javascript:void(0)" class="link" @onclick="@(e => _productPopupComponent.ShowEdit(_product))">Указать вес без упаковки</a></h3>
    }
    else
    {
        <div>Вес без упаковки: @_product?.Weight <a class="link" href="javascript:void(0)" @onclick="@(e => _productPopupComponent.ShowEdit(_product!))">Изменить вес без упаковки</a></div>
    }

    <div>Продано штук: @_totalCount</div>
    <div>Средняя выручка с одной штуки: @_meanProfitPerPcs.ToString("#") @WellKnown.Currencies.TargetCurrency</div>


    <PlotlyChart @bind-Config="@_config" @bind-Layout="@_layout" @bind-Data="@_data" @ref="@_chart" ClickAction="GraphClickAction" AfterRender="SubscribeEvents" style="height: 60vh; min-height: 350px"/>


    <table id="lotSalesTable" class="table">
        <thead>
        <tr>
            <th>Название</th>
            <th></th>
            <th>Состояние</th>
            <th>Тест</th>
            <th>Шт.</th>
            <th>Цена</th>
            <th>Доставка</th>
            <th>Доставка (доп)</th>
            <th>Валюта</th>
            <th>Продаж лота</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var lot in _lots)
        {
            <tr>
                <td>
                    <a id="@GetLotLinkId(lot.LotId)" href="@GetLinkToLot(lot)" target="_blank">@lot.Name</a>
                </td>
                <td>
                    <button class="btn btn-danger btn-sm oi oi-basket" @onclick="@(e => OnDeleteButtonClick(lot))"></button>
                </td>
                <td>@GetCondition(lot)</td>
                <td>@GetTestState(lot)</td>
                <td>@lot.Pcs</td>
                <td>@lot.Price</td>
                <td>@lot.Shipping</td>
                <td>@lot.ShippingAdditional</td>
                <td>@lot.Currency</td>
                <td>@GetPurchaseHistorySummary(purchaseInfos: lot.PurchaseHistory)</td>
            </tr>
        }
        </tbody>
    </table>

    <ProductPopup @ref="_productPopupComponent" OnSuccess="@OnInitializedAsync"/>
    <QuestionPopup @ref="_questionPopup"/>
}

@code {

    private readonly ParametersModel _parametersModel = new();
    EditContext _parametersModelEditContext = null!;

    private PlotlyChart _chart = null!;
    private ProductPopup _productPopupComponent = null!;
    private ProductWithId? _product;
    private ICollection<LotInfoShort>? _lots;
    private QuestionPopup _questionPopup = null!;

    Config _config = new();
    Layout _layout = new();
    IList<ITrace> _data = new List<ITrace>();
    int _totalCount;
    double _meanProfitPerPcs;
    private Dictionary<string, List<ShippingRateInner>> _shippingRates = null!;
    private Dictionary<string, double> _currencyRates = null!;
        private const string Worldwide = "Worldwide";

    [Parameter]
    public Guid ProductId { get; set; }

    private void GraphClickAction(IEnumerable<EventDataPoint> eventData)
    {
        var point = eventData.First();
        var scatter = (Scatter)_data[point.TraceIndex];
        var lotId = (long)scatter.CustomData[(int)point.PointIndex];
        var trLotId = GetLotLinkId(lotId);
        Logger.LogWarning(trLotId);

        Interop.SetFocusByElementId(trLotId);
    }

    private async void SubscribeEvents()
    {
        await _chart.SubscribeClickEvent();
    }

    protected override async Task OnInitializedAsync()
    {
        var productTask = EbayClient.GetProductAsync(ProductId);
        var getCurrenciesTask = GetCurrencies();
        var getShippingRatesTask = EbayClient.GetShippingRatesAsync();
        await Task.WhenAll(productTask, getCurrenciesTask, getShippingRatesTask);

        _product = productTask.Result;
        _currencyRates = getCurrenciesTask.Result;
        _shippingRates = GetShippingRates(getShippingRatesTask.Result, getCurrenciesTask.Result);

        _parametersModelEditContext = new EditContext(_parametersModel);

        await UpdateData();
        StateHasChanged();
    }

    private async Task UpdatePage()
    {
        await UpdateData();
        StateHasChanged();
        await _chart.Update();
    }

    private void OnDeleteButtonClick(LotInfoShort lot)
    {
        _questionPopup.AskQuestion(questionText: $"Вы действительно хотите удалить лот '{lot.Name}'?", onSubmit: async () =>
        {
            await EbayClient.DeleteLotInfoAsync(lot.LotId);
            await UpdatePage();
        });
    }

    private async Task UpdateData()
    {
        if (_product == null) throw new NullReferenceException(nameof(_product));

        _lots = await GetLots();
        if (_lots.Count == 0) return;

        _data = new List<ITrace>();

        var totalCount = 0;
        var totalProfit = 0.0;

        foreach (var grouping in GenerateStatistics(lots: _lots).GroupBy(x => (x.Condition,x.TestState)))
        {
            totalCount += grouping.Sum(x => x.ItemsInPurchase);
            totalProfit += grouping.Sum(x => x.ProfitPerPcs * x.ItemsInPurchase);

            _data.Add(new Scatter
            {
                Marker = new Marker { Color = GetColor(grouping.Key.Condition, grouping.Key.TestState) },
                Mode = ModeFlag.Markers | ModeFlag.Text,
                X = grouping.Select(x => x.ProfitPerPcs).Cast<object>().ToList(),
                Y = grouping.Select(x => x.ItemsInPurchase).Cast<object>().ToList(),
                Name = $"{grouping.Key.Condition}, {grouping.Key.TestState}" ,
                CustomData = grouping.Select(x => x.LotId).Cast<object>().ToList(),
                HoverTemplate = $"%{{x:.2f}} {WellKnown.Currencies.TargetCurrency}<br>%{{y}} шт"
            });
        }
        _totalCount = totalCount;
        _meanProfitPerPcs = totalCount > 0 ? totalProfit / totalCount : 0;

        _config = new();

        _layout = new()
        {
            Title = new() { Text = $"Продажи {_product.Name}" },
            Margin = new Margin { R = 0, L = 0 },
            XAxis = new List<XAxis>()
            {
                new()
                {
                    Title = new() { Text = $"Цена за штуку ({WellKnown.Currencies.TargetCurrency})" }
                }
            },
            YAxis = new List<YAxis>()
            {
                new()
                {
                    MinAllowed = 0,
                    Title = new() { Text = "Кол-во штук в продаже" }
                }
            },
            Shapes = new List<Shape>()
            {
                new()
                {
                    Type = TypeEnum.Line,
                    X0 = _meanProfitPerPcs,
                    X1 = _meanProfitPerPcs,
                    XRef = "x",
                    YRef = "paper",
                    Y0 = 0,
                    Y1 = 1,
                    Line = new Line
                    {
                        Width = 3,
                        Color = "lightblue"
                    }
                }
            }
        };
    }

    private static string GetColor(string condition, string testState)
    {
        return condition switch
        {
            WellKnown.Categories.Conditions.New => testState switch
            {
                WellKnown.Categories.TestState.NotTested => "#1D8348", //зеленый
                WellKnown.Categories.TestState.Tested => "#B7950B",//желтый
                WellKnown.Categories.TestState.Matched => "#B03A2E",//красный
                _ => throw new ArgumentOutOfRangeException(nameof(testState))
                },
            WellKnown.Categories.Conditions.Used => testState switch
            {
                WellKnown.Categories.TestState.NotTested => "#616A6B",//серый
                WellKnown.Categories.TestState.Tested => "#5499C7",//бледно-синий
                WellKnown.Categories.TestState.Matched => "#21618C", //синий
                _ => throw new ArgumentOutOfRangeException(nameof(testState))
                },
            WellKnown.Categories.Conditions.NotWorking => "#000000",
            _ => throw new ArgumentOutOfRangeException(nameof(condition))};
    }

    private static string GetSelectedConditions(ParametersModel parametersModel)
    {
        var conditions = new HashSet<string>();
        if (parametersModel.New)
        {
            conditions.Add(WellKnown.Categories.Conditions.New);
        }

        if (parametersModel.Used)
        {
            conditions.Add(WellKnown.Categories.Conditions.Used);
        }

        return string.Join(separator: ",", values: conditions);
    }


    private IEnumerable<Purchase> GenerateStatistics(ICollection<LotInfoShort> lots)
    {
        if (_product == null) throw new NullReferenceException(nameof(_product));

    // ReSharper disable IdentifierTypo
        const double скидкаНаПродажиСНеизвестнойЦеной = 0.2;
        const double коммисияEbayВПроцентах = 0.1325;
        const double коммиссияEbayПостояннаяВеличина = 0.1325;
        const double коммисияPayoneerВПроцентах = 0.05; //todo уточнить
        const double множительДляУчетаВесаУпаковки = 1.5;

        var курсЦелевойВалюты = _currencyRates[WellKnown.Currencies.TargetCurrency];

        foreach (var lot in lots)
        {
            var condition = GetCondition(lot);
            var testState = GetTestState(lot);

            foreach (var purchase in lot.PurchaseHistory)
            {
                var количествоШтукВПродаже = lot.Pcs * purchase.Quantity;

                var ценаДоставкиВДоллларах = _parametersModel.SubtractShippingCosts ? GetShippingPrice(
                    shippingCountry: lot.ShippingCountry,
                    weight: _product.Weight * количествоШтукВПродаже * множительДляУчетаВесаУпаковки) : 0.0;

                var ценаЛотаВВалютеЛота = purchase.Price ?? lot.Price * (1.0 - скидкаНаПродажиСНеизвестнойЦеной);
                var ценаДоставкиВВалютеЛота = _parametersModel.SubtractShippingCosts ? (lot.Shipping!.Value + lot.ShippingAdditional!.Value * (purchase.Quantity - 1)) : 0.0;

                var полнаяЦенаПродажиВВалютеЛота = ценаЛотаВВалютеЛота * purchase.Quantity + ценаДоставкиВВалютеЛота;

                var полнаяЦенаПродажиВДолларах = полнаяЦенаПродажиВВалютеЛота / _currencyRates[lot.Currency];

                var выручкаСПродажиВДолларах = полнаяЦенаПродажиВДолларах
                    - полнаяЦенаПродажиВДолларах * коммисияEbayВПроцентах
                    - коммиссияEbayПостояннаяВеличина
                    - полнаяЦенаПродажиВДолларах * коммисияPayoneerВПроцентах
                    - ценаДоставкиВДоллларах;

                var выручкаСПродажиЗаШтукуВДолларах = выручкаСПродажиВДолларах / количествоШтукВПродаже;

                var выручкаСПрдажиЗаШтукуВЦелевойВалюте = выручкаСПродажиЗаШтукуВДолларах * курсЦелевойВалюты;

                yield return new Purchase(
                    LotId: lot.LotId,
                    Condition: condition,
                    TestState: testState,
                    ItemsInPurchase: количествоШтукВПродаже,
                    ProfitPerPcs: выручкаСПрдажиЗаШтукуВЦелевойВалюте);
            }
        }
    // ReSharper restore IdentifierTypo
    }

    private double GetShippingPrice(string shippingCountry, double weight)
    {
        if (!_shippingRates.TryGetValue(shippingCountry, out var shippingRates))
        {
            throw new InvalidOperationException($"{shippingCountry} not found in shippingRates");
        }

        var prices = _shippingRates[Worldwide].Concat(shippingRates);

    //var pricesString = string.Join(", ", prices);
    //Logger.LogWarning($"Calculate shipping price for {shippingCountry}, and weight {weight}, prices: '{pricesString}'");

        return prices.Where(x => x.WeightFrom <= weight && weight <= x.WeightTo).Min(x => x.PriceDollar);
    }

    private static string GetCondition(LotInfoShort lot)
    {
        return lot.Categories.Single(x => x.Type == WellKnown.Categories.Conditions.CategoryName).Value!;
    }

    private static string GetTestState(LotInfoShort lot)
    {
        return lot.Categories.Single(x => x.Type == WellKnown.Categories.TestState.CategoryName).Value!;
    }

    private record struct Purchase(long LotId, string Condition, string TestState, int ItemsInPurchase, double ProfitPerPcs);


    private string GetLinkToLot(LotInfoShort lot) => $"https://www.ebay.com/itm/{lot.LotId}?tool_productId={ProductId}";

    private static string GetLotLinkId(long lotId) => $"tr_lot_id_{lotId}";

    private static MarkupString GetPurchaseHistorySummary(ICollection<PurchaseInfo> purchaseInfos)
    {
        var sb = new StringBuilder();
        var isFirst = true;

        foreach (var groupingByIsRecent in purchaseInfos.GroupBy(x => x.IsRecent).OrderByDescending(x => x.Key))
        {
            if (!groupingByIsRecent.Key)
            {
                sb.Append("<font color = 'gray'>");
            }

            foreach (var groupingByPrice in groupingByIsRecent.GroupBy(x => x.Price).OrderByDescending(x => x.Key))
            {
                if (isFirst)
                {
                    isFirst = false;
                }
                else
                {
                    sb.Append("<br>");
                }

                if (groupingByPrice.Key.HasValue)
                {
                    sb.Append(groupingByPrice.Key.Value);
                }
                else
                {
                    sb.Append("Неизвестно");
                }

                sb.Append(" - ");

                sb.Append(groupingByPrice.Count());
            }

            if (!groupingByIsRecent.Key)
            {
                sb.Append("</font>");
            }
        }


        return (MarkupString)sb.ToString();
    }


    public class ParametersModel
    {
        public bool SubtractShippingCosts { get; set; } = true;
        public bool IsRecent { get; set; } = true;
        public bool New { get; set; } = true;
        public bool Used { get; set; }
    }

    private async Task<ICollection<LotInfoShort>> GetLots()
    {
        var lots = await EbayClient.GetLotsAsync(conditions:
            GetSelectedConditions(_parametersModel),
            testStates: null,
            onlyRecentSales: _parametersModel.IsRecent,
            productId: ProductId);
        foreach (var lotInfoShort in lots)
        {
            lotInfoShort.SetIsRecentToPurchases();
        }
        return lots;
    }

    private async Task<Dictionary<string, double>> GetCurrencies()
    {
        var currencies = await EbayClient.GetCurrenciesAsync();
        return currencies.ToDictionary(keySelector: x => x.EbayName, elementSelector: x => x.Rate);
    }

    private static Dictionary<string, List<ShippingRateInner>> GetShippingRates(
        ICollection<ShippingType> shippingRates, Dictionary<string, double> currencies)
    {
        var rates = new Dictionary<string, List<ShippingRateInner>>();

        foreach (var shippingRate in shippingRates)
        {
            foreach (var shippingRateRate in shippingRate.Rates)
            {
                if (shippingRateRate == null) throw new NullReferenceException(nameof(shippingRate));

                foreach (var rate in shippingRateRate.Rates)
                {
                    if (shippingRateRate.SpecifiedCountries == null)
                    {
                        rates.AppendOrCreateNewCollection(key: Worldwide, value: new ShippingRateInner(
                            WeightFrom: rate.MinWeight,
                            WeightTo: rate.MaxWeight,
                            PriceDollar: rate.Price / currencies[shippingRate.Currency]));
                    }
                    else
                    {
                        foreach (var specifiedCountry in shippingRateRate.SpecifiedCountries)
                        {
                            if (rate == null!) throw new NullReferenceException(nameof(rate));

                            rates.AppendOrCreateNewCollection(key: specifiedCountry, value: new ShippingRateInner(
                                WeightFrom: rate.MinWeight,
                                WeightTo: rate.MaxWeight,
                                PriceDollar: rate.Price / currencies[shippingRate.Currency]));
                        }
                    }
                }
            }
        }

        return rates;
    }

    private record struct ShippingRateInner(int WeightFrom, int WeightTo, double PriceDollar)
    {
        public override string ToString()
        {
            return $"{WeightFrom}-{WeightTo} : {PriceDollar}";
        }
    };

}