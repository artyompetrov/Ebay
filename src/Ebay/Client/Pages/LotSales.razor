@using Client.Clients.Generated
@using Microsoft.AspNetCore.Authorization
@using Plotly.Blazor
@using Plotly.Blazor.Traces
@using System.Text
@using Plotly.Blazor.Interop
@using Plotly.Blazor.LayoutLib
@using Plotly.Blazor.LayoutLib.ShapeLib
@using Plotly.Blazor.Traces.ScatterLib
@using Client.Extensions
@using Line = Plotly.Blazor.LayoutLib.ShapeLib.Line
@attribute [Authorize]
@inject EbayClient EbayClient
@inject ILogger<LotSales> Logger

<style>
    #lotSalesTable th {
      position: sticky;
      top: 3.5rem;
      background-color: white;
      z-index: 100;
    }
    
    #lotSalesTable td {
      vertical-align: middle;
    }
    
    a:focus {
        background-color: #dcdcdc;
    }
</style>

@if (_lots != null)
{
    <div style="display: flex; align-items: center; gap: 10px;">
        <button class="btn btn-primary btn-sm" @onclick="UpdateAllPrices">Пересчитать цены</button>
        @if (Product.IsCheckRequired)
        {
            <button class="btn btn-warning btn-sm" @onclick="@(e => MarkAsChecked(Product))">Отметить как проверенный</button>
        }
    </div>
    @if (Product.Weight == 0)
    {
        <h5 class="text-danger">Вес без упаковки не задан, для правильного расчета нужно задать вес</h5>
    }
    else
    {
        <div>Вес без упаковки: @Product.Weight</div>
    }

    <div>Продано штук: @(Product.ProductCalculationResult?.QuantityTotal)</div>
    <div>Средняя выручка с одной штуки: @((Product.ProductCalculationResult?.RevenueAvg * _targetCurrencyRate)?.ToString("F1"))  @WellKnown.Currencies.TargetCurrency</div>
    <div>Расчетная цена лота на ebay за штуку: @((Product.ProductCalculationResult?.ListingPriceAvg)?.ToString("F1"))  @WellKnown.Currencies.USD</div>
    <div>Запросы (eBay):
    @foreach (var query in Product!.SearchQueries)
    {
        <span><a href="@Helpers.GetSearchLink(query: query.Query, productId: Product.Id)" rel="noreferrer" target="_blank">@Helpers.HighlightMinorityLetters(query.Query, "red")</a>&#160;</span>
    }
    </div>

    <PlotlyChart @bind-Config="@_config" @bind-Layout="@_layout" @bind-Data="@_data" @ref="@_chart" ClickAction="GraphClickAction" AfterRender="SubscribeEvents" style="height: 60vh; min-height: 350px"/>


    <table id="lotSalesTable" class="table">
        <thead>
        <tr>
            <th>Название</th>
            <th></th>
            <th>Состояние</th>
            <th>Тест</th>
            <th>Шт.</th>
            <th>Цена</th>
            <th>Доставка</th>
            <th>Доставка (доп)</th>
            <th>Валюта</th>
            <th>Продаж лота</th>
            <th>Продано штук всего</th>
            <th>Общая выручка (@WellKnown.Currencies.USD)</th>
            <th>Общая выручка за штуку (@WellKnown.Currencies.USD)</th>
            <th style="background-color:#e0f7fa;">Расчетная цена листинга за штуку (@WellKnown.Currencies.USD)</th>
            <th style="background-color:#e0f7fa;">Средняя выручка (@WellKnown.Currencies.TargetCurrency)</th>
            <th>Дата расчета</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var lot in _lots)
        {
            // индикация некорректного расчета
            var style = (lot.LotCalculationResult?.QuantityTotal ?? 0) == 0 ? "background-color: pink" : "";
            <tr style="@style">
                <td>
                    <a id="@GetLotLinkId(lot.LotId)" href="@GetLinkToLot(lot)" rel="noreferrer" target="_blank">@lot.Name</a>
                </td>
                <td>
                    <button class="btn btn-danger btn-sm oi oi-basket" @onclick="@(e => OnDeleteButtonClick(lot))"></button>
                </td>
                <td>@lot.GetCondition()</td>
                <td>@lot.GetTestState()</td>
                <td>@lot.Pcs</td>
                <td>@lot.Price</td>
                <td>@lot.Shipping</td>
                <td>@lot.ShippingAdditional</td>
                <td>@lot.Currency</td>
                <td>@GetPurchaseHistorySummary(purchaseInfos: lot.PurchaseHistory)</td>
                <td>@lot.LotCalculationResult?.QuantityTotal</td>
                <td>@lot.LotCalculationResult?.Revenue.ToString("F1")</td>
                <td>@lot.LotCalculationResult?.RevenueAvg.ToString("F1")</td>
                <td>@lot.LotCalculationResult?.ListingPriceAvg.ToString("F1")</td>
                <td>@((lot.LotCalculationResult?.RevenueAvg * _targetCurrencyRate)?.ToString("F1"))</td>
                <td>@lot.LotCalculationResult?.CalculationDate</td>
            </tr>
        }
        </tbody>
    </table>

    <QuestionPopup @ref="_questionPopup"/>
}

@code {

    private PlotlyChart _chart = null!;
    private ICollection<LotInfoShort>? _lots;
    private QuestionPopup _questionPopup = null!;

    Config _config = new();
    Layout _layout = new();
    IList<ITrace> _data = new List<ITrace>();
    private Dictionary<string, double> _currencyRates = null!;
    private double _targetCurrencyRate;

    [Parameter]
    public ProductWithId Product { get; set; } = null!;

    private void GraphClickAction(IEnumerable<EventDataPoint> eventData)
    {
        var point = eventData.First();
        var scatter = (Scatter)_data[point.TraceIndex];
        var lotId = (long)scatter.CustomData[((System.Text.Json.JsonElement)point.PointIndex).GetInt32()];
        var trLotId = GetLotLinkId(lotId);
        Logger.LogWarning(trLotId);

        Interop.SetFocusByElementId(trLotId);
    }

    private async void SubscribeEvents()
    {
        await _chart.SubscribeClickEvent();
    }

    protected async override Task OnParametersSetAsync()
    {
        _currencyRates = await GetCurrencies();
        _targetCurrencyRate = _currencyRates[WellKnown.Currencies.TargetCurrency];

        await UpdateData();
    }

    private void UpdateAllPrices()
    {
        _questionPopup.AskQuestion(questionText: "Пересчитать цены?", async () => { await EbayClient.CalculatePricesForProductAsync(Product.Id, CancellationToken.None); });
    }

    private async Task UpdatePage()
    {
        await UpdateData();
        StateHasChanged();
        await _chart.Update(_data, _layout);
    }

    private void OnDeleteButtonClick(LotInfoShort lot)
    {
        _questionPopup.AskQuestion(
            questionText: $"Вы действительно хотите удалить лот '{lot.Name}'?",
            onSubmit: async () =>
            {
                await EbayClient.DeleteLotInfoAsync(lot.LotId);
                await UpdatePage();
            });
    }

    private async Task UpdateData()
    {
        _lots = await GetLots();
        if (_lots.Count == 0) return;

        _data = new List<ITrace>();

        foreach (var grouping in _lots.GroupBy(x => (Condition: x.GetCondition(), TestState: x.GetTestState())))
        {
            var purchases = grouping.SelectMany(x => x.PurchaseHistory.Select(y => (x.LotId, y.PurchaseCalculationResult))).ToList();

            _data.Add(
                new Scatter
                {
                    Marker = new Marker { Color = GetColor(condition: grouping.Key.Condition, testState: grouping.Key.TestState) },
                    Mode = ModeFlag.Markers | ModeFlag.Text,
                    X = purchases.Select(x => x.PurchaseCalculationResult.RevenueAvg * _targetCurrencyRate).Cast<object>().ToList(),
                    Y = purchases.Select(x => x.PurchaseCalculationResult.QuantityTotal).Cast<object>().ToList(),
                    Name = $"{grouping.Key.Condition}, {grouping.Key.TestState}",
                    CustomData = purchases.Select(x => x.LotId).Cast<object>().ToList(),
                    HoverTemplate = $"%{{x:.2f}} {WellKnown.Currencies.TargetCurrency}<br>%{{y}} шт"
                });
        }

        _config = new();

        _layout = new()
        {
            Title = new() { Text = $"Продажи {Product.Name}" },
            Margin = new Margin { R = 0, L = 0 },
            XAxis = new List<XAxis>() { new() { Title = new() { Text = $"Цена за штуку ({WellKnown.Currencies.TargetCurrency})" } } },
            YAxis = new List<YAxis>() { new() { MinAllowed = 0, Title = new() { Text = "Кол-во штук в продаже" } } },
            Shapes = new List<Shape>()
            {
                new()
                {
                    Type = TypeEnum.Line,
                    X0 = Product.ProductCalculationResult.RevenueAvg * _targetCurrencyRate,
                    X1 = Product.ProductCalculationResult.RevenueAvg * _targetCurrencyRate,
                    XRef = "x",
                    YRef = "paper",
                    Y0 = 0,
                    Y1 = 1,
                    Line = new Line { Width = 3, Color = "lightblue" }
                }
            }
        };
    }

    private void MarkAsChecked(ProductWithId product)
    {
        _questionPopup.AskQuestion(
            questionText: $"Вы действительно хотите отметить товар '{product.Name}' как учтенный?",
            async () =>
            {
                await EbayClient.MarkProductAsCheckedAsync(product.Id);
                product.IsCheckRequired = false;
                await UpdatePage();
            });
    }

    private static string GetColor(string condition, string testState)
    {
        return condition switch
        {
            WellKnown.Categories.Conditions.New => testState switch
            {
                WellKnown.Categories.TestState.NotTested => "#1D8348", //зеленый
                WellKnown.Categories.TestState.Tested => "#B7950B", //желтый
                WellKnown.Categories.TestState.Matched => "#B03A2E", //красный
                _ => throw new ArgumentOutOfRangeException(nameof(testState))
            },
            WellKnown.Categories.Conditions.Used => testState switch
            {
                WellKnown.Categories.TestState.NotTested => "#616A6B", //серый
                WellKnown.Categories.TestState.Tested => "#5499C7", //бледно-синий
                WellKnown.Categories.TestState.Matched => "#21618C", //синий
                _ => throw new ArgumentOutOfRangeException(nameof(testState))
            },
            WellKnown.Categories.Conditions.NotWorking => "#000000",
            _ => throw new ArgumentOutOfRangeException(nameof(condition))
        };
    }


    private string GetLinkToLot(LotInfoShort lot) => $"https://www.ebay.com/itm/{lot.LotId}?tool_productId={Product.Id}";

    private static string GetLotLinkId(long lotId) => $"tr_lot_id_{lotId}";

    private static MarkupString GetPurchaseHistorySummary(ICollection<PurchaseInfo> purchaseInfos)
    {
        var sb = new StringBuilder();
        var isFirst = true;

        foreach (var groupingByIsRecent in purchaseInfos.GroupBy(x => x.IsRecent).OrderByDescending(x => x.Key))
        {
            if (!groupingByIsRecent.Key)
            {
                sb.Append("<font color = 'gray'>");
            }

            foreach (var groupingByPrice in groupingByIsRecent.GroupBy(x => x.Price).OrderByDescending(x => x.Key))
            {
                if (isFirst)
                {
                    isFirst = false;
                }
                else
                {
                    sb.Append("<br>");
                }

                if (groupingByPrice.Key.HasValue)
                {
                    sb.Append(groupingByPrice.Key.Value);
                }
                else
                {
                    sb.Append("Неизвестно");
                }

                sb.Append(" - ");

                sb.Append(groupingByPrice.Count());
            }

            if (!groupingByIsRecent.Key)
            {
                sb.Append("</font>");
            }
        }


        return (MarkupString)sb.ToString();
    }

    

    private async Task<ICollection<LotInfoShort>> GetLots()
    {
        var lots = await EbayClient.GetLotsAsync(
            productId: Product.Id);

        return lots;
    }

    private async Task<Dictionary<string, double>> GetCurrencies()
    {
        var currencies = await EbayClient.GetCurrenciesAsync();
        return currencies.ToDictionary(keySelector: x => x.EbayName, elementSelector: x => x.Rate);
    }

}