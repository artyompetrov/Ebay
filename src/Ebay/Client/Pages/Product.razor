@page "/Product/{ProductId:guid}/{Tab?}"
@using Microsoft.AspNetCore.Authorization
@using System.Threading.Tasks
@attribute [Authorize]

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(GetTabClass(TabKind.LotSales))" href="javascript:void(0)" @onclick="() => Activate(TabKind.LotSales)">Продажи</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(GetTabClass(TabKind.Measurements))" href="javascript:void(0)" @onclick="() => Activate(TabKind.Measurements)">Измерения</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(GetTabClass(TabKind.Parameters))" href="javascript:void(0)" @onclick="() => Activate(TabKind.Parameters)">Параметры</a>
    </li>
</ul>

@if (_activeTab == TabKind.LotSales)
{
    <LotSales ProductId="ProductId" />
}
else if (_activeTab == TabKind.Measurements)
{
    <Measurements ProductId="ProductId" />
}
else if (_activeTab == TabKind.Parameters)
{
    <ProductPopup ProductId="ProductId" Inline="true" OnSuccess="OnProductUpdated" />
}

@code {
    [Parameter]
    public Guid ProductId { get; set; }

    [Parameter]
    public string? Tab { get; set; }

    private enum TabKind
    {
        LotSales,
        Measurements,
        Parameters
    }

    private TabKind _activeTab;

    protected override void OnParametersSet()
    {
        _activeTab = Tab switch
        {
            { } t when t.Equals(nameof(TabKind.Measurements), StringComparison.OrdinalIgnoreCase) => TabKind.Measurements,
            { } t when t.Equals(nameof(TabKind.Parameters), StringComparison.OrdinalIgnoreCase) => TabKind.Parameters,
            _ => TabKind.LotSales
        };
    }

    private void Activate(TabKind tab) => _activeTab = tab;

    private string GetTabClass(TabKind tab) => _activeTab == tab ? "active" : string.Empty;

    private Task OnProductUpdated() => Task.CompletedTask;
}
