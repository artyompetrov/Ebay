@page "/"
@using System.Text.RegularExpressions
@using Client.Clients.Generated
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject EbayClient EbayClient

<PageTitle>Перечень товаров</PageTitle>
<div style="display: flex; align-items: center; gap: 10px;">
    <h2>Перечень товаров</h2>
    <button class="btn btn-primary btn-sm" @onclick="UpdateAllPrices">Пересчитать цены</button>
</div>
<style>
    #productTable th {
      position: sticky;
      top: 3.5rem;
      background-color: white;
      z-index: 100;
    }
    
    #productTable td {
      vertical-align: middle;
    }
</style>


<table id="productTable" class="table">
    <thead>
    <tr>
        <th></th>
        <th></th>
        <th>Название <button class="btn btn-primary btn-sm" @onclick="@(() => _productPopupComponent.ShowCreate())">Добавить</button></th>
        <th>Другие названия</th>
        <th>Запрос (eBay)</th>
        <th>Вес без упаковки</th>
        <th>Шт. продано</th>
        <th>Средняя выручка (USD)</th>
        <th>Средняя выручка (@WellKnown.Currencies.TargetCurrency)</th>
        <th></th>
    </tr>
    </thead>

    <tbody>
    @foreach (var product in _products)
    {
        <tr>
            <td>
                <button class="btn btn-primary btn-sm oi oi-pencil" @onclick="@(e => _productPopupComponent.ShowEdit(product))"></button>
            </td>
            <td>
                @if (product.IsCheckRequired)
                {
                <button class="btn btn-warning btn-sm oi oi-check" @onclick="@(e => MarkAsChecked(product))"></button>
                }
            </td>
            <td>
                <NavLink href="@($"LotSales/{product.Id}")" target="_blank">@Helpers.HighlightMinorityLetters(product.Name, "red")</NavLink>
            </td>
            <td>
                @foreach (var query in product.RuSearchQueries)
                {
                    <span>@Helpers.HighlightMinorityLetters(query.Query, "red")&#160;</span>
                }
            </td>
            <td>
                @foreach (var query in product.SearchQueries)
                {
                    <span><a href="@Helpers.GetSearchLink(query: query.Query, productId: product.Id)" rel="noreferrer" target=”_blank”>@Helpers.HighlightMinorityLetters(query.Query, "red")</a>&#160;</span>
                }
            </td>
            @if (product.Weight == 0)
            {
                <td class="text-danger">Не задан</td>
            }
            else
            {
                <td>@product.Weight</td>
            }
            @if (product.ProductCalculationResult?.QuantityTotal > 0)
            {
                <td>@product.ProductCalculationResult?.QuantityTotal</td>
                <td>@product.ProductCalculationResult?.RevenueAvg.ToString("N0")</td>
                <td>@((product.ProductCalculationResult?.RevenueAvg * _targetCurrencyRate)?.ToString("N0"))</td>
            }
            else
            {
                <td></td>
                <td></td>
                <td></td>
            }
            <td>
                <button class="btn btn-danger btn-sm oi oi-basket" @onclick="@(e => OnDeleteButtonClick(product))"></button>
            </td>
        </tr>
    }
    </tbody>
</table>

<ProductPopup @ref="_productPopupComponent" OnSuccess="LoadActualProductList"/>
<QuestionPopup @ref="_questionPopup"/>

@code {
    private ProductPopup _productPopupComponent = null!;
    private QuestionPopup _questionPopup = null!;
    private double _targetCurrencyRate;

    private ICollection<ProductWithId> _products = new List<ProductWithId>();

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadActualProductList(), GetCurrencies());
    }

    private async Task GetCurrencies()
    {
        var currencies = await EbayClient.GetCurrenciesAsync();
        var dict = currencies.ToDictionary(keySelector: x => x.EbayName, elementSelector: x => x.Rate);
        _targetCurrencyRate = dict[WellKnown.Currencies.TargetCurrency];
    }
    
    private void OnDeleteButtonClick(ProductWithId product)
    {
        _questionPopup.AskQuestion(questionText: $"Вы действительно хотите удалить товар '{product.Name}'?", async () =>
        {
            await EbayClient.DeleteProductAsync(product.Id);
            await LoadActualProductList();
        });
    }

    private void UpdateAllPrices()
    {
        _questionPopup.AskQuestion(questionText: "Пересчитать цены для всех?", async () =>
        {
            await EbayClient.CalculatePricesForAllAsync(CancellationToken.None);
        });
    }

    private async Task LoadActualProductList()
    {
        _products = await EbayClient.GetAllProductsAsync();
        StateHasChanged();
    }

    

    private void MarkAsChecked(ProductWithId product)
    {
        _questionPopup.AskQuestion(questionText: $"Вы действительно хотите отметить товар '{product.Name}' как учтенный?", async () =>
        {
            await EbayClient.MarkProductAsCheckedAsync(product.Id);
            await LoadActualProductList();
        });
    }

}