@page "/"
@using System.Text.RegularExpressions
@using Client.Clients.Generated
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject EbayClient EbayClient

<PageTitle>Перечень товаров</PageTitle>
<div style="display: flex; align-items: center; gap: 10px;">
    <h2>Перечень товаров</h2>
    <button class="btn btn-primary btn-sm" @onclick="UpdateAllPrices">Пересчитать цены</button>
</div>
<style>
    #productTable th {
      position: sticky;
      top: 3.5rem;
      background-color: white;
      z-index: 100;
    }
    
    #productTable td {
      vertical-align: middle;
    }
</style>


<table id="productTable" class="table">
    <thead>
    <tr>
        <th></th>
        <th></th>
        <th>Название <button class="btn btn-primary btn-sm" @onclick="@(() => _productPopupComponent.ShowCreate())">Добавить</button></th>
        <th>Другие названия</th>
        <th>Запрос (eBay)</th>
        <th>Вес без упаковки</th>
        <th>Шт. продано</th>
        <th>Средняя выручка (USD)</th>
        <th></th>
    </tr>
    </thead>

    <tbody>
    @foreach (var product in _products)
    {
        <tr>
            <td>
                <button class="btn btn-primary btn-sm oi oi-pencil" @onclick="@(e => _productPopupComponent.ShowEdit(product))"></button>
            </td>
            <td>
                @if (product.IsRecheckRequired)
                {
                <button class="btn btn-warning btn-sm oi oi-check" @onclick="@(e => MarkAsChecked(product))"></button>
                }
            </td>
            <td>
                <NavLink href="@($"LotSales/{product.Id}")" target="_blank">@HighlightMinorityLetters(product.Name, "red")</NavLink>
            </td>
            <td>
                @foreach (var query in product.RuSearchQueries)
                {
                    <span>@HighlightMinorityLetters(query.Query, "red")&#160;</span>
                }
            </td>
            <td>
                @foreach (var query in product.SearchQueries)
                {
                    <span><a href="@GetSearchLink(query: query.Query, productId: product.Id)" rel="noreferrer" target=”_blank”>@HighlightMinorityLetters(query.Query, "red")</a>&#160;</span>
                }
            </td>
            @if (product.Weight == 0)
            {
                <td class="text-danger">Не задан</td>
            }
            else
            {
                <td>@product.Weight</td>
            }
            @if (product.Weight == 0)
            {
                <td>0</td>
                <td></td>
            }
            else
            {
                <td>@product.ProductCalculationResult?.QuantityTotal</td>
                <td>@product.ProductCalculationResult?.RevenueAvg.ToString("N0")</td>
            }
            <td>
                <button class="btn btn-danger btn-sm oi oi-basket" @onclick="@(e => OnDeleteButtonClick(product))"></button>
            </td>
        </tr>
    }
    </tbody>
</table>

<ProductPopup @ref="_productPopupComponent" OnSuccess="LoadActualProductList"/>
<QuestionPopup @ref="_questionPopup"/>

@code {
    private ProductPopup _productPopupComponent = null!;
    private QuestionPopup _questionPopup = null!;

    private ICollection<ProductWithId> _products = new List<ProductWithId>();

    protected override async Task OnInitializedAsync()
    {
        await LoadActualProductList();
    }

    private void OnDeleteButtonClick(ProductWithId product)
    {
        _questionPopup.AskQuestion(questionText: $"Вы действительно хотите удалить товар '{product.Name}'?", async () =>
        {
            await EbayClient.DeleteProductAsync(product.Id);
            await LoadActualProductList();
        });
    }

    private void UpdateAllPrices()
    {
        _questionPopup.AskQuestion(questionText: "Пересчитать цены для всех?", async () =>
        {
            await EbayClient.CalculatePricesForAllAsync(CancellationToken.None);
        });
    }

    private async Task LoadActualProductList()
    {
        _products = await EbayClient.GetAllProductsAsync();
        StateHasChanged();
    }

    private string GetSearchLink(string query, Guid productId) => $"https://www.ebay.com/sch/i.html?_nkw={query}&LH_Sold=1&tool_productId={productId}";

    private void MarkAsChecked(ProductWithId product)
    {
        _questionPopup.AskQuestion(questionText: $"Вы действительно хотите отметить товар '{product.Name}' как учтенный?", async () =>
        {
            await EbayClient.MarkProductAsCheckedAsync(product.Id);
            await LoadActualProductList();
        });
    }

    private static readonly Regex RussianLettersRegex = new(@"\p{IsCyrillic}+", RegexOptions.Compiled);
    private static readonly Regex EnglishLettersRegex = new(@"[A-Za-z]+", RegexOptions.Compiled);
    
    /// <summary>
    /// Подсвечивает «меньшинство» (русские или английские буквы) в заданном тексте.
    /// Если русских больше, подсвечивает английские, и наоборот.
    /// </summary>
    /// <param name="text">Входная строка</param>
    /// <param name="color">Цвет подсветки (например "red")</param>
    /// <returns>Готовый HTML (MarkupString) для Blazor</returns>
    private static MarkupString HighlightMinorityLetters(string text, string color)
    {
        if (string.IsNullOrWhiteSpace(text))
            return new MarkupString(string.Empty);

        // 1. Подсчитываем кол-во русских и английских символов
        var totalRussian = RussianLettersRegex
            .Matches(text)
            .Sum(m => m.Length);

        var totalEnglish = EnglishLettersRegex
            .Matches(text)
            .Sum(m => m.Length);

        // 2. Если русских больше - подсвечиваем английские, иначе - русские
        var highlightEnglish = totalRussian >= totalEnglish;

        // 3. Меняем «меньшинство» через Replace
        var highlightedText = highlightEnglish
            ? EnglishLettersRegex.Replace(text, match => 
                $"<span style=\"color:{color};\">{match.Value}</span>")
            : RussianLettersRegex.Replace(text, match => 
                $"<span style=\"color:{color};\">{match.Value}</span>");

        return new MarkupString(highlightedText);
    }
}