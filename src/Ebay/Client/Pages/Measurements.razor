@page "/Measurements/{ProductId:guid}"
@using System.Text.Json
@using Client.Clients.Generated
@using Microsoft.AspNetCore.Authorization
@using Newtonsoft.Json
@attribute [Authorize]
@inject EbayClient EbayClient
@inject ILogger<Measurements> Logger

<script src="https://unpkg.com/html5-qrcode"></script>
<style>
    #reader video {
        transform: scaleX(-1); /* зеркалирование по горизонтали */
    }
    #typeSelect {
        width: 300px;
    }
    #monthInput {
        width: 300px;
    }
</style>

@if (_measurements != null)
{
    <div class="row">
        <div class="col-md-6 pe-4 border-end border-secondary">
            @if (_product != null)
            {
                <div style="display: flex; align-items: center; gap: 10px;">
                    <h3 style="margin: 0">Добавить измерение для @_product.Name</h3>
                    <NavLink class="btn btn-primary btn-sm" href="@($"/ebay_description/{_product.Id}")" target="_blank">Описание для eBay</NavLink>
                </div>
            }
            <br>
            <div id="reader" style="width: 500px;"></div>
            @if (_error != null)
            {
                <p style="color:red">@_error</p>
            }

            @if (_message != null)
            {
                <p style="color:green">@_message</p>
            }
            <br>
            <label for="typeSelect">Тип измерения:</label>
            <select id="typeSelect" class="form-control" @bind="_selectedState">
                <option value="">-- выберите тип --</option>
                @foreach (var state in _productStates)
                {
                    <option value="@state">@state</option>
                }
            </select>
            <br>
            <label for="manufactureCodeInput">Код или дата производства в формате yyyy-mm:</label>
            <input id="manufactureCodeInput" @bind="_manufactureCode" type="text" class="form-control" lang="en" />

            <label for="locationInput">Место хранения (необязательно):</label>
            <input id="locationInput" @bind="_location" type="text" class="form-control" lang="en" />

            <label for="matchIdInput">Match ID (необязательно):</label>
            <input id="matchIdInput" @bind="_matchId" type="text" class="form-control" lang="en" />
            <br>
            <InputFile OnChange="HandleFileSelected" accept=".zip" />
        </div>
        <div class="col-md-6 ps-4">
            <div class="mb-2">
                <label>Количество элементов в комплекте:</label>
                <input type="number" min="2" class="form-control" style="width: 100px;" @bind="_matchCount" />
            </div>
            <div class="mb-2">
                <label>Статусы для подбора:</label>
                <div>
                    @foreach (var state in _measurementStates.Where(s => s != MeasurementState.Sold))
                    {
                        <label class="me-2">
                            <input type="checkbox" checked="@_statesToMatch.Contains(state)" @onchange="e => OnMatchStateChanged(state, e)" />
                            @GetMeasurementStateEmoji(state) @state.ToString("G")
                        </label>
                    }
                </div>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="includeExisting" @bind="_includeExisting" />
                <label class="form-check-label" for="includeExisting">учитывать в подборе измерения, что уже включены в существующую пару</label>
            </div>
            <button class="btn btn-primary btn-sm" @onclick="OnFindMatchedClick">Подобрать</button>
        </div>
    </div>
    <br>
    <h3>Зарегистрированные замеры:</h3>
    <label for="stateFilter">Фильтр по статусу:</label>
    <select id="stateFilter" class="form-control" @onchange="OnFilterChanged">
        <option value="">-- все --</option>
        @foreach (var state in _measurementStates)
        {
            <option value="@state" selected="@(_selectedMeasurementState == state)">
                @GetMeasurementStateEmoji(state) @state.ToString("G")
            </option>
        }
    </select>
    <table class="table">
        <thead>
        <tr>
            <th>Название</th>
            <th>Код</th>
            <th>Состояние</th>
            <th>Статус</th>
            <th>Расположение</th>
            <th>Match ID</th>
            <th></th>
        </tr>
        </thead>
        <tbody>

        @foreach (var measurement in _measurements)
        {
            <tr>
                <td><NavLink href="@($"m/{measurement.MeasurementId}")" target="_blank">@measurement.MeasurementId</NavLink></td>
                <td>@measurement.ManufactureCode</td>
                <td>@measurement.ProductState.ToString("G")</td>
                <td>
                    <select class="form-select"
                            value="@measurement.MeasurementState"
                            @onchange="async e => await OnMeasurementStateChanged(measurement, Enum.Parse<MeasurementState>(e.Value!.ToString()!))">
                        @foreach (var state in _measurementStates)
                        {
                            <option value="@state" selected="@(state == measurement.MeasurementState)">
                                @GetMeasurementStateEmoji(state) @state.ToString("G")
                            </option>
                        }
                    </select>
                </td>
                <td>
                    <input type="text"
                           class="form-control"
                           value="@measurement.Location"
                           @oninput="async e => await OnLocationChanged(measurement, e.Value?.ToString())" />
                </td>
                <td>
                    <input type="text"
                           class="form-control"
                           value="@measurement.MatchId"
                           @oninput="async e => await OnMatchIdChanged(measurement, e.Value?.ToString())" />
                </td>
                <td><button class="btn btn-danger btn-sm oi oi-basket" @onclick="@(e => OnDeleteButtonClick(measurement.MeasurementId))"></button></td>
            </tr>
        }
        </tbody>
    </table>
}

<QuestionPopup @ref="_questionPopup"/>

@code {
    private ProductWithId? _product;
    private string? _error;
    private string? _message;
    private ProductState? _selectedState;
    private List<ProductState> _productStates = Enum.GetValues(typeof(ProductState)).Cast<ProductState>().ToList();
    private List<MeasurementState> _measurementStates = Enum.GetValues(typeof(MeasurementState)).Cast<MeasurementState>().ToList();
    private MeasurementState? _selectedMeasurementState;
    private ICollection<MeasurementData>? _measurements;
    private QuestionPopup _questionPopup = null!;
    private string? _manufactureCode;
    private string? _location;
    private string? _matchId;
    private HashSet<MeasurementState> _statesToMatch = new();
    private int _matchCount = 2;
    private bool _includeExisting;

    [Parameter]
    public Guid ProductId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _product = await EbayClient.GetProductAsync(ProductId);
        _statesToMatch = _measurementStates
            .Where(s => s != MeasurementState.Sold && s != MeasurementState.Selling)
            .ToHashSet();
        await UpdateMeasurementsAsync();
    }

    private async Task UpdateMeasurementsAsync()
    {
        _measurements = await EbayClient.GetMeasurementsAsync(_selectedMeasurementState, ProductId);
        StateHasChanged();
    }

    private async Task OnFilterChanged(ChangeEventArgs e)
    {
        _selectedMeasurementState = string.IsNullOrWhiteSpace(e.Value?.ToString())
            ? null
            : Enum.Parse<MeasurementState>(e.Value!.ToString()!);

        await UpdateMeasurementsAsync();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (_product == null) throw new NullReferenceException(nameof(_product));

        try
        {
            _message = null;
            _error = null;

            var file = e.File;

            if (!file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
            {
                _error = "Разрешены только zip файлы";
                return;
            }

            if (file.ContentType != "application/zip" && file.ContentType != "application/x-zip-compressed")
            {
                _error = $"Невалидный MIME type: {file.ContentType}";
                return;
            }

            var qrCodeData = await Interop.StartQrScanner();
            var id = qrCodeData.Split('/').Last();

            await using var stream = file.OpenReadStream();
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            await EbayClient.UploadMeasurementAsync(
                measurementData: new MeasurementDataToUpload
                {
                    File = ms.ToArray(),
                    MeasurementId = id,
                    ManufactureCode = _manufactureCode,
                    ProductState = _selectedState ?? throw new InvalidOperationException("Тип измерения не выбран"),
                    Location = _location,
                    MatchId = _matchId
                },
                _product.Id,
                CancellationToken.None);

            _message = $"Успешно загружен {id}";
        }
        catch (ApiException<ValidationProblemDetailedInfo> ex)
        {
            _error = JsonConvert.SerializeObject(ex.Result);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        await UpdateMeasurementsAsync();
    }

    private void OnDeleteButtonClick(string measurementMeasurementId)
    {
        _questionPopup.AskQuestion(
            $"Вы действительно хотите удалить измерение '{measurementMeasurementId}'?",
            async () =>
            {
                await EbayClient.DeleteMeasurementAsync(ProductId, measurementMeasurementId);
                await UpdateMeasurementsAsync();
            });
    }

    private async Task OnLocationChanged(MeasurementData measurement, string? newValue)
    {
        try
        {
            measurement.Location = newValue;
            await EbayClient.UpdateMeasurementLocationAsync(newValue, ProductId, measurement.MeasurementId);
            Logger.LogInformation("Updated note for {Id}: {Note}", measurement.MeasurementId, newValue);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating note for {Id}", measurement.MeasurementId);
            _error = "Ошибка при обновлении заметки";
        }
    }

    private async Task OnMatchIdChanged(MeasurementData measurement, string? newValue)
    {
        try
        {
            measurement.MatchId = newValue;
            await EbayClient.UpdateMeasurementMatchIdAsync(newValue, ProductId, measurement.MeasurementId);
            Logger.LogInformation("Updated Match Id for {Id}: {Match}", measurement.MeasurementId, newValue);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating match id for {Id}", measurement.MeasurementId);
            _error = "Ошибка при обновлении match id";
        }
    }

    private void OnMatchStateChanged(MeasurementState state, ChangeEventArgs e)
    {
        var selected = e.Value as bool? == true;
        if (selected)
        {
            _statesToMatch.Add(state);
        }
        else
        {
            _statesToMatch.Remove(state);
        }
    }

    private void OnFindMatchedClick()
    {
        if (_product == null) throw new NullReferenceException(nameof(_product));

        _questionPopup.AskQuestion(
            questionText: "Подобрать комплект?",
            async () =>
            {
                await EbayClient.FindMatchedMeasurementsAsync(
                    new FindMatchParameters
                    {
                        MatchCount = _matchCount,
                        MeasurementStates = _statesToMatch.ToList(),
                        IncludeExisting = _includeExisting
                    },
                    _product.Id);
                await UpdateMeasurementsAsync();
            });
    }

    private async Task OnMeasurementStateChanged(MeasurementData measurement, MeasurementState newState)
    {
        try
        {
            measurement.MeasurementState = newState;
            await EbayClient.UpdateMeasurementStateAsync(newState, ProductId, measurement.MeasurementId);
            Logger.LogInformation("Updated state for {Id}: {State}", measurement.MeasurementId, newState);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating state for {Id}", measurement.MeasurementId);
            _error = "Ошибка при обновлении статуса";
        }
    }

    private static string GetMeasurementStateEmoji(MeasurementState state)
    {
        return state switch
        {
            MeasurementState.Created => "\uD83C\uDD95",
            MeasurementState.Selling => "\uD83D\uDED2",
            MeasurementState.Sold => "\u2705",
            _ => string.Empty
        };
    }
}
