@using System.Reflection

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="navbar-brand-title">Ebay</span>
            <span class="navbar-brand-version">@($"v{AssemblyVersion}")</span>
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Товары" aria-label="Товары">
                <span class="oi oi-list-rich" aria-hidden="true"></span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="shippingRates" title="Тарифы почты" aria-label="Тарифы почты">
                <span class="oi oi-envelope-closed" aria-hidden="true"></span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="currencies" title="Курсы валют" aria-label="Курсы валют">
                <span class="oi oi-dollar" aria-hidden="true"></span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" target="_blank" href="chrome_extensions/download/mlebgdemjnpnfgcgbbncllpniiicffbm.zip" title="Плагин для Chrome" aria-label="Плагин для Chrome">
                <span class="oi oi-data-transfer-download" aria-hidden="true"></span>
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private static readonly string AssemblyVersion =
        Assembly.GetExecutingAssembly().GetName().Version?.ToString() ?? string.Empty;

    private bool _collapseNavMenu = true;

    private string? NavMenuCssClass => _collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        _collapseNavMenu = !_collapseNavMenu;
    }

}