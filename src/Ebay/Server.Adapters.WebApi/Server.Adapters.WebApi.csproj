<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Server.Adapters.WebApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NSwag.MSBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="GenerateControllers" BeforeTargets="BeforeBuild">
    <Exec Command="$(NSwagExe_Net100) run ControllerGenerationConfig.json" />
  </Target>

  <ItemGroup>
    <Compile Include="$(BaseIntermediateOutputPath)Generated/Controllers/**/*.cs" />
  </ItemGroup>

</Project>
