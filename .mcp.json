{
  "mcpServers": {
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "grafana": {
      "command": "uvx",
      "args": ["mcp-grafana"],
      "env": {
        "GRAFANA_URL": "https://anode.su/grafana",
        "GRAFANA_USERNAME": "mcp",
        "GRAFANA_PASSWORD": "${GRAFANA_MCP_PASSWORD}"
      }
    }
  }
}
